exports[`Help snapshots — contract stability > help for ib task list matches snapshot 1`] = `
"USAGE
  ib task list [flags]

DESCRIPTION
  List recurring operator tasks, most-overdue first (nextDueAt ASC). Developer-only. Default scope: active tasks; --due narrows to tasks due NOW (nextDueAt <= now); --inactive includes deactivated ones. The daily AI runner sweeps \`ib task list --due --executor ai --agent claude\`.
  Permissions: requires isSystemAdmin or isDeveloper.

FLAGS
  --due    Only tasks due now (nextDueAt <= now)
  --executor STRING    human | ai
  --agent STRING    claude | hermes — recommendedAgent filter (AI tasks)
  --assignee NUMBER    Only tasks assigned to this personId
  --asiakas NUMBER    Only tasks scoped to this company (asiakasId); internal/global tasks have asiakasId NULL
  --inactive    Include deactivated tasks (default: active only)
  --limit NUMBER    Max rows (cap 200) (default: 50)
  --offset NUMBER    Pagination offset (default: 0)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { items: TaskRow[], nextCursor: null, count, truncated? } — TaskRow = { taskId, title, instructions, skillRef, executor, recommendedAgent, assigneePersonId, asiakasId, cadenceUnit, cadenceCount, nextDueAt, lastDoneAt, active, feedbackId, ... }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Validation             → --executor must be human|ai; --agent must be claude|hermes; --assignee/--asiakas/--limit/--offset must be integers
  exit 3 (HTTP 403)  Permission denied      → requires a developer token (isSystemAdmin/isDeveloper)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib task list --due
  ib task list --due --executor ai --agent claude
  ib task list --executor human --assignee 10
  ib task list --asiakas 8 --inactive
"
`;

exports[`Help snapshots — contract stability > help for ib task log matches snapshot 1`] = `
"USAGE
  ib task log <id> [flags]

DESCRIPTION
  Completion history for one task, newest first (developer-only). agent non-null = AI completion; outcome failed rows explain why a task is still due.
  Permissions: requires isSystemAdmin or isDeveloper.

ARGUMENTS
  <id> NUMBER    taskId (required)

FLAGS
  --limit NUMBER    Max rows (cap 200) (default: 50)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { items: LogRow[], nextCursor: null, count, truncated? } — LogRow = { logId, taskId, doneAt, donePersonId, agent, outcome, notes }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this command caps at 200, so narrow by task rather than raising the cap
  exit 3 (HTTP 403)  Permission denied      → requires a developer token
  exit 5 (HTTP 404)  Not found              → check the id via \`ib task list --inactive\`
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib task complete, ib task get

EXAMPLES
  ib task log 7
  ib task log 7 --limit 10
"
`;

exports[`Help snapshots — contract stability > help for ib task set matches snapshot 1`] = `
"USAGE
  ib task set <id> [flags]

DESCRIPTION
  Partial update of a recurring task (developer-only; a write). Omit a flag to KEEP the current value; pass "" to CLEAR a text field (--instructions/--skill/--agent). On Windows PowerShell a bare "" is DROPPED and the NEXT flag silently becomes the value — use the equals form \`--instructions=\` there, which means the same thing in bash (\`ib help shell-quoting\`). --deactivate soft-retires the task (history kept); --activate restores it. --next-due overrides the due date without logging a completion.
  Permissions: requires isSystemAdmin or isDeveloper.

ARGUMENTS
  <id> NUMBER    taskId (required)

FLAGS
  --title STRING    New title
  --instructions STRING    New instructions ("" clears)
  --skill STRING    New skillRef ("" clears)
  --executor STRING    human | ai
  --agent STRING    claude | hermes ("" clears)
  --assignee NUMBER    New assignee personId
  --asiakas NUMBER    New company scope (asiakasId)
  --cadence STRING    <count>/<unit>, unit day|week|month, count 1-120. Mutually exclusive with --once.
  --once    Convert to a SINGLE-SHOT task (cadenceUnit=once): completion retires it instead of rolling nextDueAt. This is the conversion path for a task already faking 'once' as --cadence 120/month. cadenceCount is left untouched — it is meaningless for a one-off.
  --next-due STRING    Override nextDueAt (YYYY-MM-DD or today/tomorrow)
  --activate    Reactivate; mutually exclusive with --deactivate
  --deactivate    Soft-retire the task (active=0)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  The full updated task row. With --dry-run: { dryRun:true, wouldWrite:{...} } (server-side preview).

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Validation             → provide at least one field; --activate/--deactivate and enum values as documented; --assignee/--asiakas must be integers
  exit 3 (HTTP 403)  Permission denied      → requires a developer token; also refused under --read-only
  exit 5 (HTTP 404)  Not found              → check the id via \`ib task list --inactive\`
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib task set 7 --cadence 2/month --reason "cadence tuning"
  ib task set 7 --deactivate --reason "task retired"
  ib task set 7 --skill "" --reason "no automation yet — back to morning-report surfacing"
"
`;

exports[`Help snapshots — contract stability > help for ib validate matches snapshot 1`] = `
"USAGE
  ib validate [<action>] [flags]

DESCRIPTION
  Validate a company OR a single employee against a profile — a pass/fail/skip checklist with Finnish details naming what is missing. Entity is inferred from --person: absent → company (profiles: jerry, betoni; --profile required); present → person (profile: onboarding, default). \`ib validate list\` lists profiles. Company: GET /api/validation/:profile/:asiakasId. Person: GET /api/validation/person/:profile/:asiakasId/:personId.
  Permissions: requires company: system admin OR admin-tier role in the target (or owner) company, person: the above OR HR admin (typeId 24) of the target company.

ARGUMENTS
  <action> STRING    Use 'list' to list available profiles; omit to run validation. (optional)

FLAGS
  --asiakas NUMBER    Target asiakasId (default: active company)
  --person NUMBER    Validate this person as an employee (switches to person validation)
  --profile STRING    Profile id (company: jerry|betoni, required; person: onboarding, default)
  --keikka NUMBER    Validate this keikka against the reminders-drawer rules (alias of \`ib keikka validate <id>\`)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  list: ListEnvelope<{ id, titleFi, description, entity:'company'|'person' }>. company: { entity:'company', profile, asiakasId, asiakasNimi, ok, summary, checks[] }. person: { entity:'person', profile, asiakasId, asiakasNimi, personId, personNimi, ok, summary, checks:[{ id, severity, status:'pass'|'fail'|'skip', titleFi, detail? }] }.

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Not an admin/HR of the target company → use an admin/HR token
  exit 5 (HTTP 404)  Unknown profile for that entity, or company/person not found → run \`ib validate list\` to see profiles
  exit 4 (client-side)  Missing --profile for company validation, or a non-positive --asiakas/--person → pass --profile (jerry|betoni) for a company, or a positive --asiakas/--person; run \`ib validate list\`

NOTES
  - ok = every applicable 'required' check passes; skipped checks (conditional, not applicable) and recommended/optional never flip it.
  - status 'skip' = the check did not apply (e.g. Ajoneuvot-moduuli only checked for pumppari); excluded from summary counts.
  - Exit code is 0 even when ok:false — the JSON carries the outcome.
  - Deploy-gated: returns 404 until /api/validation is deployed.
  - 'ib company validate' was renamed to this command (exit 4 on the old path).

SEE ALSO
  ib person get, ib customer modules, ib jerry admin detail

EXAMPLES
  ib validate list
  ib validate --asiakas 8 --profile betoni
  ib validate --asiakas 8 --person 10
  ib validate --person 10 --profile onboarding
  ib validate --keikka 9001
"
`;

exports[`Help snapshots — contract stability > help for ib vehicle create matches snapshot 1`] = `
"USAGE
  ib vehicle create [flags]

DESCRIPTION
  Create a vehicle. Two-step backend flow (POST /api/vehicle/new/:asiakasId then /save). --asiakas creates the vehicle UNDER that tenant (it rides the /new path param, which stamps ownerAsiakasId+asiakasId on the stub — fb#94); default = active company from JWT. Requires an admin/owner/vehicleHandler role on the target tenant. Dry-run previews via /new without inserting.
  Permissions: requires auth.page.vehicle.edit.

FLAGS
  --reg STRING    Registration number (vehicleRegNo)
  --name STRING    Display name (vehicleNimi)
  --no NUMBER    Fleet number (vehicleNo)
  --type NUMBER    vehicleTypeId (see ib vehicle types)
  --memo STRING    Free-text memo
  --default-driver NUMBER    Default driver personId
  --capacity NUMBER    Concrete capacity in m3 (vehicleM3)
  --puomi NUMBER    Boom length in metres (vehiclePuomi — informational; BetoniJerry matching uses sijainti puomiMin/puomiMax since 2026-07)
  --asiakas NUMBER    Target asiakasId to create the vehicle under (defaults to active company; needs a vehicle-manage role on that tenant)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { vehicleId, ... } (raw backend save response) | { dryRun, wouldCreate }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --asiakas is not an integer >= 1, rejected locally before any request → pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach
  exit 4 (HTTP 400)  Validation failed      → fix the field flags
  exit 3 (HTTP 403)  No vehicle-edit access on the target tenant (--asiakas if given, otherwise your active company) → you need an admin/owner/vehicleHandler role on that tenant
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.vehicle.edit
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib vehicle create --reg ABC-123 --type 1 --capacity 7.5 --reason 'new truck'
  ib vehicle create --reg ABC-123 --type 2 --puomi 24 --asiakas 1380 --reason 'jerry onboarding'
  ib vehicle create --reg ABC-123 --dry-run
"
`;

