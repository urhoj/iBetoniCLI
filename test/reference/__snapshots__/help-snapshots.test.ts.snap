  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ pumppuOfferId, providerAsiakasId, providerNimi, providerContactName, priceCents, vatPercent, status, scheduledAt, keikkaId }>

ERRORS (stderr, exit non-zero)
