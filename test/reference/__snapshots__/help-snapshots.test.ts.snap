  ib opendata weather keikka 9001 --force-refresh
"
`;

exports[`Help snapshots — contract stability > help for ib opendata weather pumping matches snapshot 1`] = `
"USAGE
  ib opendata weather pumping [flags]

DESCRIPTION
  Weather analysis over a concrete-pumping window: hourly conditions for the entire duration starting at --start. The backend can correlate with a keikka via --keikka for error reporting. Requires the company weather module.
  Permissions: requires company weather module (asiakasPersonSettingTypeId 18).

FLAGS
  --lat NUMBER    Latitude (Finland 59.5–70.1)
  --lng NUMBER    Longitude (Finland 19.0–31.6)
  --start STRING    Pumping start time (ISO 8601 or 'now')
  --duration NUMBER    Pumping duration in minutes
  --keikka NUMBER    Keikka id (optional, for backend error correlation only)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { hourly: [{ time, temperature, windSpeed, precipitation, weatherSymbol }], summary, coordinates }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --lat/--lng not a number, or --duration/--keikka not a positive integer → pass decimal degrees and whole minutes, e.g. --lat 60.17 --lng 24.94 --duration 120
  exit 3 (HTTP 403)  Weather module off or permission denied → enable via 'ib opendata weather toggle --on'
  exit 4 (HTTP 400)  Bad coords/time/duration → use Finland coords, valid ISO time, positive duration
  exit 2 (HTTP 401)  Not authenticated      → run 'ib auth login'
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib opendata weather pumping --lat 60.17 --lng 24.94 --start now --duration 120
  ib opendata weather pumping --lat 60.17 --lng 24.94 --start 2026-06-10T08:00:00Z --duration 90 --keikka 1234
"
`;

