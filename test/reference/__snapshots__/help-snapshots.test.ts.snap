// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Help snapshots — contract stability > help for ib attachment attach matches snapshot 1`] = `
"USAGE
  ib attachment attach <attachmentId> [flags]

DESCRIPTION
  Link an EXISTING attachment to one entity (sets that FK; an attachment may be linked to several entities at once — other links are untouched).
  Auth: requires login (any authenticated user).

ARGUMENTS
  <attachmentId> NUMBER    attachments.attachmentId (required)

FLAGS
  --keikka NUMBER    Target keikkaId
  --vehicle NUMBER    Target vehicleId
  --person NUMBER    Target personId
  --customer NUMBER    Target asiakasId
  --worksite NUMBER    Target tyomaaId
  --sijainti NUMBER    Target sijaintiId
  --tuote NUMBER    Target tuoteId
  --bug-report NUMBER    Target bugReportId
  --request NUMBER    Jerry pumppuRequestId (request owner only)
  --offer NUMBER    Jerry pumppuOfferId (provider company only)
  --message NUMBER    Target messageId (chat message; attach = message author, read = thread participant)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, attachmentId, <column>: entityId } | { dryRun: true, wouldAttach: {...} }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  invalid <attachmentId> positional, rejected locally before any request → attachmentId must be a positive integer — verify it with \`ib attachment list\` or \`ib attachment search\`
  exit 5 (HTTP 404)  Attachment not found   → verify attachmentId
  exit 3 (HTTP 403)  No membership on attachment or target → check active company
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Exactly ONE entity flag selects the target (--keikka | --vehicle | --person | --customer | --worksite | --sijainti | --tuote | --bug-report | --request | --offer | --message).
  - Audited via ChangeTracker on the target entity's timeline.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment detach, ib attachment list

EXAMPLES
  ib attachment attach 4711 --vehicle 53
  ib attachment attach 4711 --keikka 9002 --dry-run
"
`;

exports[`Help snapshots — contract stability > help for ib attachment delete matches snapshot 1`] = `
"USAGE
  ib attachment delete <attachmentId> [flags]

DESCRIPTION
  Soft-delete the DB row AND hard-delete the Azure blob — the blob deletion is IRREVERSIBLE. --reason is hard-required (client exits 4 without it; server 400s without the header). Requires a manager role on the owner company.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <attachmentId> NUMBER    attachments.attachmentId (required)

FLAGS
  (none)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED (blob deletion is irreversible).

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, attachmentId, deleted: true, blobDeleted } | { dryRun: true, wouldDelete: { attachmentId, blobName, origFileName } }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  invalid <attachmentId> positional, rejected locally before any request → attachmentId must be a positive integer — verify it with \`ib attachment list\` or \`ib attachment search\`
  exit 4 (client-side)  Missing --reason       → pass --reason 'why'
  exit 4 (HTTP 400)  Missing X-Action-Reason header → pass --reason
  exit 3 (HTTP 403)  Not owner company or missing manager role → switch to the owner company
  exit 5 (HTTP 404)  Attachment not found or already deleted → verify attachmentId
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - ALWAYS preview with --dry-run first.
  - Audited via ChangeTracker with your --reason.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment get, ib attachment detach

EXAMPLES
  ib attachment delete 4711 --dry-run --reason preview
  ib attachment delete 4711 --reason "duplicate upload"
"
`;

exports[`Help snapshots — contract stability > help for ib attachment detach matches snapshot 1`] = `
"USAGE
  ib attachment detach <attachmentId> [<entity>] [flags]

DESCRIPTION
  Unlink an attachment from ONE entity (NULLs that FK). Requires a manager role (Admin / KeikkaHandler / AttachmentHandler / Owner) on the attachment's OWNER company — same gate as the web UI. A fully unlinked attachment appears in \`ib attachment search --missing\`.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <attachmentId> NUMBER    attachments.attachmentId (required)
  <entity> STRING    keikka|vehicle|person|customer|worksite|sijainti|tuote|bug-report|request|offer (omit when using a --<entity> flag instead) (optional)

FLAGS
  --keikka NUMBER    Target keikkaId
  --vehicle NUMBER    Target vehicleId
  --person NUMBER    Target personId
  --customer NUMBER    Target asiakasId
  --worksite NUMBER    Target tyomaaId
  --sijainti NUMBER    Target sijaintiId
  --tuote NUMBER    Target tuoteId
  --bug-report NUMBER    Target bugReportId
  --request NUMBER    Jerry pumppuRequestId (request owner only)
  --offer NUMBER    Jerry pumppuOfferId (provider company only)
  --message NUMBER    Target messageId (chat message; attach = message author, read = thread participant)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, attachmentId, detached: entity } | { dryRun: true, wouldDetach: {...} }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  invalid <attachmentId> positional, rejected locally before any request → attachmentId must be a positive integer — verify it with \`ib attachment list\` or \`ib attachment search\`
  exit 3 (HTTP 403)  Not owner company or missing manager role → switch to the owner company; need Admin/KeikkaHandler/AttachmentHandler/Owner
  exit 5 (HTTP 404)  Attachment not found   → verify attachmentId
  exit 4 (client-side)  No entity given, conflicting positional + flag, or unknown entity word → name the entity once — positional word OR a --<entity> flag
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Name the entity as a positional word (\`detach 4711 keikka\`) OR an attach-style flag (\`detach 4711 --keikka 9001\`) — the flag's id is ignored since detach only needs the entity name.
  - Audited via ChangeTracker on the previously-linked entity's timeline.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment attach, ib attachment search

EXAMPLES
  ib attachment detach 4711 keikka
  ib attachment detach 4711 --keikka 9001
  ib attachment detach 4711 bug-report --dry-run
"
`;

exports[`Help snapshots — contract stability > help for ib attachment download matches snapshot 1`] = `
"USAGE
  ib attachment download <attachmentId> [flags]

DESCRIPTION
  Download the file to LOCAL disk (get + fetch blobUrl + write). Defaults to the original file name in the current directory; refuses to overwrite without --force. LOCAL ONLY — denied on /api/cli/exec and MCP because it would write the SERVER's filesystem.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <attachmentId> NUMBER    attachments.attachmentId (required)

FLAGS
  --out STRING    Output path (default: origFileName in cwd)
  --force    Overwrite an existing file

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, attachmentId, file (absolute path), bytes, fileType }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  invalid <attachmentId> positional, rejected locally before any request → attachmentId must be a positive integer — verify it with \`ib attachment list\` or \`ib attachment search\`
  exit 5 (HTTP 404)  Attachment not found   → verify attachmentId
  exit 4 (client-side)  Output file exists     → pass --force or --out <other path>
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Remote callers: use \`ib attachment get\` and fetch blobUrl yourselves.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment get

EXAMPLES
  ib attachment download 4711
  ib attachment download 4711 --out C:\\temp\\site.jpg --force
"
`;

exports[`Help snapshots — contract stability > help for ib attachment get matches snapshot 1`] = `
"USAGE
  ib attachment get <attachmentId> [flags]
  (also: ib attachment show)

DESCRIPTION
  One attachment: full metadata, group/type names, and a 1-hour read-SAS blobUrl for downloading the bytes directly from Azure.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <attachmentId> NUMBER    attachments.attachmentId (required)

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { attachmentId, origFileName, fileName, fileType, fileSize, fileComment, attachTime, liitaLaskuun, attachmentGroupId, attachmentGroupName, attachmentTypeId, attachmentTypeName, keikkaId?, vehicleId?, personId?, asiakasId?, tyomaaId?, sijaintiId?, tuoteId?, bugReportId?, pumppuRequestId?, pumppuOfferId?, messageId?, entryByPersonId, ownerAsiakasId, imageWidth, imageHeight } & { fileFolder, blobUrl }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  invalid <attachmentId> positional, rejected locally before any request → attachmentId must be a positive integer — verify it with \`ib attachment list\` or \`ib attachment search\`
  exit 5 (HTTP 404)  Attachment not found (or deleted) → verify attachmentId
  exit 3 (HTTP 403)  No membership in the owner company or any keikka party → check the active company
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - blobUrl expires in 1h — fetch it promptly; re-run get for a fresh one.
  - Remote contexts (exec/MCP): fetch blobUrl yourself — \`download\` is denied there.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment download, ib attachment list

EXAMPLES
  ib attachment get 4711
"
`;

exports[`Help snapshots — contract stability > help for ib attachment list matches snapshot 1`] = `
"USAGE
  ib attachment list [flags]

DESCRIPTION
  List attachments linked to ONE entity, with group/type names on every row. Rows for companies the caller is not a member of are filtered out (keikka lists use the keikka-party check instead).
  Auth: requires login (any authenticated user).

FLAGS
  --keikka NUMBER    Target keikkaId
  --vehicle NUMBER    Target vehicleId
  --person NUMBER    Target personId
  --customer NUMBER    Target asiakasId
  --worksite NUMBER    Target tyomaaId
  --sijainti NUMBER    Target sijaintiId
  --tuote NUMBER    Target tuoteId
  --bug-report NUMBER    Target bugReportId
  --request NUMBER    Jerry pumppuRequestId (request owner only)
  --offer NUMBER    Jerry pumppuOfferId (provider company only)
  --message NUMBER    Target messageId (chat message; attach = message author, read = thread participant)
  --group STRING    Filter by group (NAME or id — \`ib attachment types\`)
  --type STRING    Filter by type (NAME or id — \`ib attachment types\`)
  --limit NUMBER    Max rows (capped at 500) (default: 100)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ attachmentId, origFileName, fileName, fileType, fileSize, fileComment, attachTime, liitaLaskuun, attachmentGroupId, attachmentGroupName, attachmentTypeId, attachmentTypeName, keikkaId?, vehicleId?, personId?, asiakasId?, tyomaaId?, sijaintiId?, tuoteId?, bugReportId?, pumppuRequestId?, pumppuOfferId?, messageId?, entryByPersonId, ownerAsiakasId, imageWidth, imageHeight }>

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this command caps at 500, so narrow by entity rather than raising the cap
  exit 3 (HTTP 403)  Not a member of the target entity's company → check the active company (ib auth whoami)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Exactly ONE entity flag selects the target (--keikka | --vehicle | --person | --customer | --worksite | --sijainti | --tuote | --bug-report | --request | --offer | --message).
  - No SAS URLs in list rows — use \`ib attachment get\` for a download URL.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment get, ib attachment types, ib attachment search

EXAMPLES
  ib attachment list --keikka 9001
  ib attachment list --vehicle 53 --group kuva
  ib attachment list --request 1234
"
`;

exports[`Help snapshots — contract stability > help for ib attachment register matches snapshot 1`] = `
"USAGE
  ib attachment register --name <name> --orig-name <orig-name> --folder <folder> --size <size> --mime <mime> [flags]

DESCRIPTION
  Persist attachment metadata AFTER the bytes are in Azure (remote-safe primitive; step 3 of the upload flow). Server stamps identity from the JWT (entryByPersonId, ownerAsiakasId) and rejects fileFolder values outside the active company.
  Auth: requires login (any authenticated user).

FLAGS
  --keikka NUMBER    Target keikkaId
  --vehicle NUMBER    Target vehicleId
  --person NUMBER    Target personId
  --customer NUMBER    Target asiakasId
  --worksite NUMBER    Target tyomaaId
  --sijainti NUMBER    Target sijaintiId
  --tuote NUMBER    Target tuoteId
  --bug-report NUMBER    Target bugReportId
  --request NUMBER    Jerry pumppuRequestId (request owner only)
  --offer NUMBER    Jerry pumppuOfferId (provider company only)
  --message NUMBER    Target messageId (chat message; attach = message author, read = thread participant)
  --name STRING    fileName returned by upload-url (required)
  --orig-name STRING    Original file name (required)
  --folder STRING    fileFolder returned by upload-url (required)
  --size NUMBER    File size in bytes (required)
  --mime STRING    MIME type (stored as fileType) (required)
  --comment STRING    fileComment
  --group STRING    Group (NAME or id; default 1)
  --type STRING    Type (NAME or id; default 1)
  --etag STRING    Azure ETag (optional)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, attachmentId } | { dryRun: true, wouldCreate: {...} }

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  fileFolder outside the active company / not a member of the target → mint via upload-url; check active company
  exit 4 (HTTP 400)  Missing required field / unknown entity → see required flags
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Exactly ONE entity flag selects the target (--keikka | --vehicle | --person | --customer | --worksite | --sijainti | --tuote | --bug-report | --request | --offer | --message).
  - Audited via ChangeTracker on the linked entity's timeline (--reason lands in changeTracker.reason).
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment upload-url, ib attachment upload

EXAMPLES
  ib attachment register --name uuid.jpg --orig-name site.jpg --folder 8/2026 --size 12345 --mime image/jpeg --keikka 9001
"
`;

exports[`Help snapshots — contract stability > help for ib attachment search matches snapshot 1`] = `
"USAGE
  ib attachment search [<text>] [flags]

DESCRIPTION
  Search attachments in the ACTIVE company by file name / comment, list orphans (no linked entity) with --missing, or — given no text and no --missing — list ALL active company attachments (parity with \`ib keikka list\`).
  Auth: requires login (any authenticated user).

ARGUMENTS
  <text> STRING    Search text; omit to list all (or combine with --missing) (optional)

FLAGS
  --missing    Only attachments with NO linked entity
  --limit NUMBER    Max rows (capped at 500) (default: 100)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ attachmentId, origFileName, fileName, fileType, fileSize, fileComment, attachTime, liitaLaskuun, attachmentGroupId, attachmentGroupName, attachmentTypeId, attachmentTypeName, keikkaId?, vehicleId?, personId?, asiakasId?, tyomaaId?, sijaintiId?, tuoteId?, bugReportId?, pumppuRequestId?, pumppuOfferId?, messageId?, entryByPersonId, ownerAsiakasId, imageWidth, imageHeight }>

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this command caps at 500, so narrow the search term rather than raising the cap
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Tenant comes from the JWT — there is no company parameter.
  - No text and no --missing lists every active attachment in the company (capped at --limit; \`truncated:true\` signals more).
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment list, ib attachment detach

EXAMPLES
  ib attachment search
  ib attachment search kuormakirja
  ib attachment search --missing
"
`;

exports[`Help snapshots — contract stability > help for ib attachment types matches snapshot 1`] = `
"USAGE
  ib attachment types [flags]

DESCRIPTION
  Attachment groups + types legend (id + name + description), tenant-scoped reference data. Use these NAMES or ids in --group/--type flags everywhere in this group.
  Auth: requires login (any authenticated user).

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { groups: [{ attachmentGroupId, attachmentGroupName, attachmentGroupDescription, active }], types: [{ attachmentTypeId, attachmentGroupId, attachmentTypeName, attachmentTypeDescription, active }] }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Cached server-side (~hours); names are the single source of truth (code constants drift).
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment list, ib attachment upload

EXAMPLES
  ib attachment types
  ib attachment types --pretty
"
`;

exports[`Help snapshots — contract stability > help for ib attachment update matches snapshot 1`] = `
"USAGE
  ib attachment update <attachmentId> [flags]

DESCRIPTION
  Update comment / group / type / invoice-flag. The server read-merges: fields you do not pass keep their current values (entity links are never touched by update). liitaLaskuun additionally requires lasku or asiakas admin.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <attachmentId> NUMBER    attachments.attachmentId (required)

FLAGS
  --comment STRING    New fileComment
  --liita-laskuun NUMBER    0|1 invoice-attachment flag (lasku/asiakas admin only)
  --group STRING    Group (NAME or id — \`ib attachment types\`)
  --type STRING    Type (NAME or id — \`ib attachment types\`)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, attachmentId } | { dryRun: true, wouldUpdate: { fileComment: {from,to}, liitaLaskuun: {from,to}, ... } }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  invalid <attachmentId> positional, rejected locally before any request → attachmentId must be a positive integer — verify it with \`ib attachment list\` or \`ib attachment search\`
  exit 3 (HTTP 403)  Not owner company / missing manager role / liitaLaskuun without lasku-admin → use an account with lasku or asiakas admin role on the owner company
  exit 5 (HTTP 404)  Attachment not found   → verify attachmentId
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Comment changes are audited via ChangeTracker.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment types, ib attachment get

EXAMPLES
  ib attachment update 4711 --comment "hyväksytty"
  ib attachment update 4711 --group laskutus --liita-laskuun 1
"
`;

exports[`Help snapshots — contract stability > help for ib attachment upload matches snapshot 1`] = `
"USAGE
  ib attachment upload <file> [flags]

DESCRIPTION
  Upload a LOCAL file and link it to ONE entity in one step (mint SAS → PUT bytes to Azure → register metadata). --dry-run is CLIENT-side: validates the file and prints the would-be payload with ZERO network calls. LOCAL ONLY — denied on /api/cli/exec and MCP because it would read the SERVER's filesystem.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <file> STRING    Path to the local file (required)

FLAGS
  --keikka NUMBER    Target keikkaId
  --vehicle NUMBER    Target vehicleId
  --person NUMBER    Target personId
  --customer NUMBER    Target asiakasId
  --worksite NUMBER    Target tyomaaId
  --sijainti NUMBER    Target sijaintiId
  --tuote NUMBER    Target tuoteId
  --bug-report NUMBER    Target bugReportId
  --request NUMBER    Jerry pumppuRequestId (request owner only)
  --offer NUMBER    Jerry pumppuOfferId (provider company only)
  --message NUMBER    Target messageId (chat message; attach = message author, read = thread participant)
  --comment STRING    fileComment shown in the UI
  --group STRING    Group (NAME or id — \`ib attachment types\`; default 1)
  --type STRING    Type (NAME or id — \`ib attachment types\`; default 1)
  --mime STRING    Override auto-detected MIME (fallback application/octet-stream)

WRITE-SAFETY FLAGS
  --dry-run            CLIENT-side preview: resolves locally, no write reaches the wire (works under --read-only).
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, attachmentId } | { dryRun: true, wouldUpload: {...} }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  File unreadable / bad entity flags → check the path and pass exactly one entity flag
  exit 6 (client-side)  Azure PUT failed       → re-run; SAS expires in 1h
  exit 3 (HTTP 403)  Not a member of the target entity's company → check active company
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Exactly ONE entity flag selects the target (--keikka | --vehicle | --person | --customer | --worksite | --sijainti | --tuote | --bug-report | --request | --offer | --message).
  - No image compression — the file uploads as-is (the web UI compresses to ~1MB).
  - Remote contexts: use upload-url + PUT yourself + register.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment upload-url, ib attachment register, ib attachment types

EXAMPLES
  ib attachment upload ./site.jpg --keikka 9001 --comment "pohjakuva"
  ib attachment upload ./tarjous.pdf --offer 567 --reason "offer docs"
  ib attachment upload ./x.pdf --vehicle 53 --dry-run
  ib attachment upload ./kuva.jpg --message 9 --comment "liite viestiin"
"
`;

exports[`Help snapshots — contract stability > help for ib attachment upload-url matches snapshot 1`] = `
"USAGE
  ib attachment upload-url --name <name> [flags]

DESCRIPTION
  Mint a 1-hour write-SAS upload URL (remote-safe primitive). The SERVER picks the blob path ({ownerAsiakasId}/{year}/{uuid}.{ext}) — callers cannot choose it. PUT your bytes to uploadUrl with header x-ms-blob-type: BlockBlob, then call \`ib attachment register\`.
  Auth: requires login (any authenticated user).

FLAGS
  --name STRING    Original file name WITH extension (required)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { uploadUrl, fileFolder, fileName, putHeaders: { 'x-ms-blob-type': 'BlockBlob' }, expiresInSeconds: 3600 }

ERRORS (stderr, exit non-zero)
  exit 4 (HTTP 400)  Missing/invalid name (needs an extension, no path separators) → pass --name file.ext
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Minting alone creates no DB row — unregistered blobs are orphans.
  - Deploy-gated (404 until the backend ships /api/cli/attachment/*).

SEE ALSO
  ib attachment register, ib attachment upload

EXAMPLES
  ib attachment upload-url --name site.jpg
"
`;

exports[`Help snapshots — contract stability > help for ib auth impersonate matches snapshot 1`] = `
"USAGE
  ib auth impersonate [<personId>] [flags]

DESCRIPTION
  Impersonate another person: mint a 10-minute impersonation JWT for the target and persist it as the active credential (your own login is stashed for restore). \`--end\` restores it; \`--extend\` renews 10 more minutes. Server-gated by canImpersonate (systemAdmin/roleManager, same-tenant admin over a non-admin target, or an explicit grant). Local CLI only — denied over the exec/MCP bridge.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <personId> NUMBER    Target personId (or use --email). Omit with --end/--extend. (optional)

FLAGS
  --email STRING    Target email (alternative to the personId positional)
  --end    End the active impersonation session and restore your own login
  --extend    Extend the active impersonation session by 10 minutes

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  start: { ok:true, impersonating:{ personId, actorPersonId, expiresAt } }. --end: { ok:true, restored:{ personId } }. --extend: { ok:true, expiresAt }.

ERRORS (stderr, exit non-zero)
  exit 2 (client-side)  Not logged in          → ib auth login
  exit 3 (HTTP 403)  Impersonation not allowed for the target → needs systemAdmin/roleManager, same-tenant admin, or a grant
  exit 5 (HTTP 404)  Target not found (or has no personEmail) → no impersonatable person for that personId/email. NB: a personId that EXISTS but has no personEmail also 404s here (impersonation is email-keyed) — verify with \`ib person get <id>\`; an email-less person cannot be impersonated.
  exit 3 (client-side)  Read-only mode active (--read-only / IB_READ_ONLY) → impersonation persists a rotated JWT; drop read-only
  exit 4 (client-side)  A session is already active — starting a second would overwrite the stashed admin profile, so --end could no longer restore you → end the current one first with \`ib auth impersonate --end\` (or \`--extend\` to keep it), then start the new target
  exit 4 (client-side)  No active session (--end/--extend), or neither personId nor --email given → start with \`ib auth impersonate <personId>\`

NOTES
  - Persists a 10-minute impersonation JWT as the active credential — blocked under read-only (exit 3).
  - Auto-refresh-on-401 is disabled while impersonating (it would escalate to a 7-day login); a 401 surfaces — re-run impersonate or \`--extend\`.
  - \`ib auth whoami\` shows an \`impersonating\` block while a session is active.
  - Target resolution is email-keyed (getPersonDataFromEmail): a person with no personEmail cannot be impersonated and 404s identically to a missing person (feedback #113) — verify a suspect personId with \`ib person get <id>\`.
  - Local CLI only — the \`auth\` group is denied over /api/cli/exec and MCP ib_exec.

EXAMPLES
  ib auth impersonate 6233
  ib auth impersonate --email someone@example.com
  ib auth impersonate --extend
  ib auth impersonate --end
"
`;

exports[`Help snapshots — contract stability > help for ib auth login matches snapshot 1`] = `
"USAGE
  ib auth login [flags]

DESCRIPTION
  Open the system browser to authorize this CLI via OAuth 2.1 + PKCE and persist credentials to ~/.ibetoni/credentials.json (mode 0600).
  Auth: none (public).

FLAGS
  --endpoint URL    API endpoint to authorize against (default: https://api.ibetoni.fi)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  stderr: the authorization URL + 'Waiting for the OAuth callback…' immediately, then 'Logged in as <email> at <company>.'; credentials file written

ERRORS (stderr, exit non-zero)
  exit 2 (client-side)  OAuth flow failed      → retry; check network / browser
  exit 2 (client-side)  Authorize preflight failed (4xx/5xx from /oauth/authorize, or endpoint unreachable) → the server's error is surfaced immediately without opening the browser (no 5-min callback hang) — fix the server-side cause (e.g. OAuth client registration / Redis) or the endpoint/network, then retry
  exit 6 (HTTP 500)  Backend error          → retry later

NOTES
  - HEADLESS/no-browser environments (CI, sandboxes): the OAuth callback must land on the machine running the CLI, so this command cannot complete there — set IB_TOKEN=<jwt> (a betoni.online JWT) in the env instead; every command picks it up (non-refreshable; a 401 surfaces immediately). The authorization URL and a waiting message are printed to stderr so a stuck flow is visible.
  - Fail-fast preflight: before opening the browser the CLI GETs the /oauth/authorize URL (10s timeout, side-effect-free server-side); a 4xx/5xx or unreachable endpoint fails immediately with the server's error instead of the silent 5-minute callback-timeout hang. A preflight TIMEOUT fails open (browser flow proceeds) so a slow cold-start never blocks a login that would have worked.

EXAMPLES
  ib auth login
  ib auth login --endpoint https://api-staging.ibetoni.fi
"
`;

exports[`Help snapshots — contract stability > help for ib auth logout matches snapshot 1`] = `
"USAGE
  ib auth logout [flags]

DESCRIPTION
  Revoke the refresh token server-side (best-effort) and delete the local credentials file.
  Auth: requires login (any authenticated user).

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  no stdout output; exit 0 on success

ERRORS (stderr, exit non-zero)
  exit 1 (client-side)  I/O error              → check file permissions

EXAMPLES
  ib auth logout
"
`;

exports[`Help snapshots — contract stability > help for ib auth refresh matches snapshot 1`] = `
"USAGE
  ib auth refresh [flags]

DESCRIPTION
  Manually refresh the JWT: JWT-bearer refresh (/api/auth/refresh-token) first, falling back to the OAuth refresh-token grant (/oauth/token) when the JWT has already expired — so a session idle past the 7-day JWT lifetime still recovers without a browser reflow (90-day refresh-token window). Automatic refresh-on-401 (same chain) also happens in the API client.
  Auth: requires login (any authenticated user).

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true }

ERRORS (stderr, exit non-zero)
  exit 2 (client-side)  Refresh failed on every path (JWT-bearer AND OAuth refresh-token grant) → ib auth login to re-authenticate
  exit 4 (client-side)  Refresh refused while impersonating (it would escalate to a permanent login as the target) → ib auth impersonate --extend (10 more minutes) or --end (restore your own login)

NOTES
  - The OAuth grant rotates the stored refresh token (single-use, reuse-detected) and persists the successor immediately. It re-mints the LOGIN-time company; if you had \`auth switch\`ed since, the CLI switches the fresh JWT back to your persisted active company automatically.

EXAMPLES
  ib auth refresh
"
`;

exports[`Help snapshots — contract stability > help for ib auth switch matches snapshot 1`] = `
"USAGE
  ib auth switch [flags]

DESCRIPTION
  Switch the active company. Issues a new JWT bound to the target ownerAsiakasId and persists it.
  Auth: requires login (any authenticated user).

FLAGS
  --to NUMBER    Target asiakasId to switch to

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, activeCompany: { asiakasId, name } }

ERRORS (stderr, exit non-zero)
  exit 2 (client-side)  Not logged in          → ib auth login
  exit 3 (HTTP 403)  No access to target    → verify ownership via \`ib company list\`
  exit 3 (client-side)  Read-only mode active (--read-only / IB_READ_ONLY) → persisted switch is blocked under read-only; use the per-command global --company <id> ephemeral context

NOTES
  - Persists a rotated JWT bound to the target company — blocked under read-only mode (exit 3).
  - For a one-command company context that does NOT persist, use the global \`--company <id>\` flag instead.

EXAMPLES
  ib auth switch --to 1349
"
`;

exports[`Help snapshots — contract stability > help for ib auth whoami matches snapshot 1`] = `
"USAGE
  ib auth whoami [flags]

DESCRIPTION
  One-shot orientation for the active session: who/where you are, what you can do (tier), and where else you can act (companies). Decoded from the JWT, so it works for IB_TOKEN sessions too (not just the on-disk creds store). An EXPIRED file session self-heals (refresh, incl. the OAuth refresh-token grant) or exits 2 — a dead session is caught here, not on your next write. Run it first.
  Auth: requires login (any authenticated user).

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { personId, email?, activeCompany: { asiakasId, name, betoniJerryUmbrella? }, tier: 'developer'|'admin'|'standard', companies: { asiakasId, roles }[], endpoint, source: 'file'|'env', readOnly, tokenExpiresAt?, tokenExpired?, refreshed?, impersonating? } — \`tier\` is the discovery/capability gate; \`companies\` are the \`company switch\` targets (no name in the JWT — use \`ib company list\` for names); \`source:'env'\` = IB_TOKEN (non-refreshable); \`refreshed: true\` = the stored JWT had expired and whoami self-healed the session before reporting.

ERRORS (stderr, exit non-zero)
  exit 2 (client-side)  Not logged in          → ib auth login first (or set IB_TOKEN)
  exit 2 (client-side)  Session expired and unrefreshable (both the JWT-bearer refresh and the OAuth refresh-token grant failed) → ib auth login to re-authenticate
  exit 2 (client-side)  IB_TOKEN expired (env sessions have no refresh path) → mint a fresh JWT and update IB_TOKEN
  exit 2 (client-side)  IB_TOKEN is not JWT-shaped (not 3 dot-separated segments) — a value problem, not a rejected credential → a command substitution (IB_TOKEN=$(…)) captures the whole stdout, banners included — re-set IB_TOKEN to the bare token
  exit 2 (client-side)  Impersonation session expired (never auto-refreshed — it would escalate) → ib auth impersonate --end to restore your own login, or re-impersonate

NOTES
  - Exit 0 means the session is USABLE: a non-expired token, or an expired file session that was just self-healed (\`refreshed: true\`; the rotated tokens are persisted). Exit 2 means re-auth is required — so \`ib auth whoami && <write>\` is a sound guard (fb#258).
  - Self-heal persists a rotated JWT/refresh token to the creds file even under --read-only — same stance as the client's transparent refresh-on-401 (local session maintenance, not a domain write).

EXAMPLES
  ib auth whoami
"
`;

exports[`Help snapshots — contract stability > help for ib betoni attr get matches snapshot 1`] = `
"USAGE
  ib betoni attr get <attrId> [flags]
  (also: ib betoni attr show)

DESCRIPTION
  One concrete additive by attrId, scoped to an owning tenant (GET /api/betoni/attr/get/:attrId/:ownerAsiakasId). The route returns a recordset even for one row; this unwraps it.
  Permissions: requires read access on the target ownerAsiakasId.

ARGUMENTS
  <attrId> NUMBER    attrId (the PK of betoniAttr) (required)

FLAGS
  --owner NUMBER    Owning tenant (ownerAsiakasId); default = your active company

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { attrId, attrNimike, attrSelite, attrYksikkö, hinta, betoniAsiakasId, ownerAsiakasId, shared, isEnabled, showInDropDown, ... }

ERRORS (stderr, exit non-zero)
  exit 5 (client-side)  no such attribute for that owner → the id may belong to ANOTHER tenant — the backend does not distinguish that from 'no such row'. Cross-check with \`ib betoni attr list <betoniAsiakasId> --owner <id>\`
  exit 4 (client-side)  no usable ownerAsiakasId on the token → pass --owner <asiakasId>, or \`ib auth switch\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  No read access to the requested ownerAsiakasId → check \`ib auth whoami\`

SEE ALSO
  ib betoni attr list

EXAMPLES
  ib betoni attr get 12
  ib betoni attr get 12 --owner 1349
"
`;

exports[`Help snapshots — contract stability > help for ib betoni attr list matches snapshot 1`] = `
"USAGE
  ib betoni attr list <betoniAsiakasId> [flags]

DESCRIPTION
  List concrete additives (betoniAttr) for one supplier under one owning tenant (GET /api/betoni/attr/list/:betoniAsiakasId/:ownerAsiakasId). Both scope columns treat 0 as "any", and the backend matches each independently.
  Permissions: requires read access on the target ownerAsiakasId.

ARGUMENTS
  <betoniAsiakasId> NUMBER    Supplier scope (0 = any supplier) (required)

FLAGS
  --owner NUMBER    Owning tenant (ownerAsiakasId); default = your active company

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ attrId, attrNimike, attrSelite, attrYksikkö, hinta, betoniAsiakasId, ownerAsiakasId, shared, isEnabled, showInDropDown, attrShortCuts, attrHelpId, entryTime, lastModifiedTime }>

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  no usable ownerAsiakasId on the token → pass --owner <asiakasId>, or \`ib auth switch\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  No read access to the requested ownerAsiakasId → you may only read a tenant you have access to — check \`ib auth whoami\`

NOTES
  - \`shared\` is true only when BOTH betoniAsiakasId AND ownerAsiakasId are 0. A row global on one axis is still scoped on the other, so a single 0 does not mean "everyone sees it".
  - \`hinta\` is decimal(10,2) NULL — null means NO PRICE SET, which is distinct from 0.

SEE ALSO
  ib betoni attr get

EXAMPLES
  ib betoni attr list 0
  ib betoni attr list 8 --owner 1349
"
`;

exports[`Help snapshots — contract stability > help for ib betoni laatu get matches snapshot 1`] = `
"USAGE
  ib betoni laatu get <laatuId> [flags]
  (also: ib betoni laatu show)

DESCRIPTION
  One concrete grade by laatuId. Resolved from the supplier's list rather than a get endpoint (the backend mounts no route for \`betoniLaatu.get\`), so visibility is identical to \`laatu list\` — you can only get a grade you could already list.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <laatuId> NUMBER    laatuId (the PK of betoniLaatu) (required)

FLAGS
  --asiakas NUMBER    Supplier whose catalogue to search; default = your active company

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { laatuId, laatuNimike, laatuLyhenne, laatuLaji, laatuSelite, sortNum, asiakasId, shared, isEnabled, showInDropDown, ... }

ERRORS (stderr, exit non-zero)
  exit 5 (client-side)  no such grade in the resolved catalogue → \`ib betoni laatu list\` to see it; a grade owned by ANOTHER supplier needs --asiakas <supplierId>
  exit 4 (client-side)  no usable ownerAsiakasId on the token → pass --asiakas <supplierId>, or \`ib auth switch\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh

SEE ALSO
  ib betoni laatu list

EXAMPLES
