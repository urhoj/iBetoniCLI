`;

exports[`Help snapshots — contract stability > help for ib legal diff matches snapshot 1`] = `
"USAGE
  ib legal diff [<a>] [<b>] [flags]

DESCRIPTION
  Line diff between two document versions WITHOUT pulling both full bodies into context. Two modes: pass two documentIds (<a> old, <b> new), or --type <name> to diff that type's newest DRAFT against its current ACTIVE version (i.e. what would change if you publish the draft). Returns per-side metadata + added/removed line counts + a compact unified diff (long unchanged runs collapse).
  Auth: requires login (any authenticated user).

ARGUMENTS
  <a> NUMBER    Old documentId (omit when using --type) (optional)
  <b> NUMBER    New documentId (omit when using --type) (optional)

FLAGS
  --type STRING    Diff newest DRAFT vs current ACTIVE of this type (instead of <a> <b>)
  --owner NUMBER    ownerAsiakasId scope for --type resolution (1349 = BetoniJerry); only valid with --type

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  {a: {documentId, typeName, version, status, contentLength}, b: {...}, sameContent, addedLines, removedLines, unified}

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Neither two documentIds nor --type supplied (or both), or --owner without --type → pass <a> <b> OR --type <name>
  exit 5 (HTTP 404)  documentId / type's draft or active not found → check ib legal versions <typeName>
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib legal versions, ib legal drafts, ib legal get

EXAMPLES
  ib legal diff 4 38
  ib legal diff --type TOS
  ib legal diff --type BETONIJERRY_TOS --owner 1349
"
`;

exports[`Help snapshots — contract stability > help for ib legal drafts matches snapshot 1`] = `
"USAGE
  ib legal drafts [flags]

DESCRIPTION
  Unpublished DRAFT versions across EVERY type — the cross-type answer to 'is anything staged to publish?' (the draft counterpart of ib legal active). One row per draft; content stripped (read a body via ib legal get, or compare with ib legal diff). Client-side fan-out over ib legal types + ib legal versions --status draft.
  Auth: requires login (any authenticated user).

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{documentId, typeName, version, title, status, effectiveDate, createdBy, createdTime, notes, ownerAsiakasId}>

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib legal active, ib legal versions, ib legal diff

EXAMPLES
  ib legal drafts
"
`;

exports[`Help snapshots — contract stability > help for ib legal get matches snapshot 1`] = `
"USAGE
  ib legal get <documentIdOrType> [flags]

DESCRIPTION
  One document version by documentId — or by typeName (e.g. PRIVACY) to read that type's current ACTIVE version, so the typeName-keyed rows of ib legal list chain directly into get. The body is returned in the \`markdownContent\` field.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <documentIdOrType> STRING    legalDocuments.documentId, or a typeName (UPPER_SNAKE, see ib legal types) resolving to its active version (required)

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  {documentId, documentTypeId, typeName, version, title, status, markdownContent, isActive, ...}

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Argument is neither a numeric documentId nor a typeName → pass a documentId from ib legal list, or a typeName like PRIVACY
  exit 5 (HTTP 404)  Document not found / type has no active document → list ids via ib legal versions <typeName>
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - The document body is the \`markdownContent\` field — NOT \`content\` or \`body\`. Reading \`.content\` returns undefined (an empty body) with no error: a silent false-negative. \`ib legal show\` uses the same field name.

SEE ALSO
  ib legal versions, ib legal diff

EXAMPLES
  ib legal get 12
  ib legal get PRIVACY
"
`;

exports[`Help snapshots — contract stability > help for ib legal save matches snapshot 1`] = `
"USAGE
  ib legal save --type <type> --doc-version <doc-version> [flags]

DESCRIPTION
  Create a NEW document version (developer/sysadmin only). Versions are IMMUTABLE — any content/title change is a new version; there is no in-place edit. Saved as status='draft' (isActive=0) by default; --activate publishes atomically (status='active', archives the prior active version of the same type+tenant). Content from --file (local) or --content (inline; required over /api/cli/exec). --reason required unless --dry-run.
  Permissions: requires isSystemAdmin or isDeveloper (server-enforced).
  Timezone: dates interpreted in active company timezone (Europe/Helsinki).

FLAGS
  --type STRING    Document type name (see ib legal types) (required)
  --doc-version STRING    Version string, e.g. 2.0, max 20 chars — DB column nvarchar(20) (NOT --version — that is the global CLI version flag) (required)
  --title STRING    Document title (required for a full save; defaults to the current doc's title in edit mode)
  --language STRING    Document language: fi (binding original) or en (unofficial translation). In edit mode (--replace/--append/--prepend) this also selects WHICH language's current active document is read. (default: fi)
  --file STRING    Read markdown content from a local file
  --content STRING    Inline markdown content (use over /api/cli/exec — no local FS there)
  --owner NUMBER    ownerAsiakasId tenant scope (1349 = BetoniJerry); omit for global
  --notes STRING    Internal notes — what the ACTIVATOR reads at the moment of activation, so this is where the activation GATES belong: the deploy gate, whether to batch with other pending edits, an EN re-translation that must land with it, and the verification evidence. No length limit (widened 500 → nvarchar(MAX) on 2026-08-12); the old ceiling is what truncated a gate set and lost it (fb#453/fb#512).
  --effective-date DATE    Effective date YYYY-MM-DD (default: now)
  --activate    Publish immediately (archives the prior active version). Default: inactive draft
  --validate-json    Validate the embedded \`\`\`json block parses to an object before saving (recommended for BETONIJERRY_* structured types)
  --replace STRING    Edit mode: replace this literal text in the current ACTIVE version's markdown (must match exactly once unless --all)
  --with STRING    Replacement for --replace (empty deletes the matched text; pass "" to clear — PowerShell DROPS a bare "", so use \`--with=\` there (same meaning in bash; \`ib help shell-quoting\`))
  --append STRING    Edit mode: append text to the end of the current markdown (verbatim)
  --prepend STRING    Edit mode: prepend text to the start of the current markdown (verbatim)
  --all    With --replace: substitute every occurrence instead of erroring on multiple matches

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED unless --dry-run.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  {documentId, success} | dry-run: {dryRun: true, wouldCreate: {...}, validation} | edit dry-run: {dryRun:true, type, field:"markdownContent", matchCount?, addedLines, removedLines, sameContent, unified}

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Missing --reason / no content / --file unreadable or combined with --content / --validate-json failed → pass --file OR --content, and --reason unless --dry-run
  exit 4 (client-side)  Edit mode (--replace/--append/--prepend) resolved to a document in a DIFFERENT language than --language — Task 8's read falls back to the fi row when no active en row exists, so this refuses rather than silently publishing Finnish content tagged language:en → create the target language version with a full --file/--content save first, then retry the edit
  exit 4 (client-side)  --doc-version exceeds 20 characters (DB column legalDocuments.version is nvarchar(20)) → shorten the version string to 20 characters or fewer
  exit 4 (HTTP 400)  A field exceeds its DB column length (SQL Server truncation error, names the column) → shorten the field the message names — title is nvarchar(200), --doc-version nvarchar(20); --notes and content are unbounded
  exit 4 (HTTP 400)  Required fields missing → provide --type --doc-version --title and content
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Developer/sysadmin only (server-enforced) → use a developer account token
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - X-Dry-Run is honoured server-side on this route once the gating deploy is live — do not --dry-run against a backend without it (the write would persist).
  - Edit mode (--replace/--append/--prepend) refuses when the served document's own language differs from --language (the fi fallback for a type with no active en document yet) — create the target language version with a full --file/--content save first.

SEE ALSO
  ib legal activate, ib legal versions

EXAMPLES
  ib legal save --type TOS --doc-version 2.1 --title Kayttoehdot --file ./tos.md --reason "new clause 7"
  ib legal save --type TOS --doc-version 2.1 --title Kayttoehdot --content "# TOS" --activate --dry-run
  ib legal save --type BETONIJERRY_OFFER_ACCEPTANCE --doc-version offer-2026-06-18 --title 'Tarjouksen hyväksyntä' --file offer.md --validate-json --reason 'update CTA copy'
  ib legal save --type TOS --doc-version 2.1 --replace "14 vrk" --with "30 vrk" --reason "extend payment term" --dry-run
  ib legal save --type TOS --doc-version 2.1 --title "Terms of Service" --file ./tos-en.md --language en --activate --reason "publish EN translation"
"
`;

exports[`Help snapshots — contract stability > help for ib legal show matches snapshot 1`] = `
"USAGE
  ib legal show <typeName> [flags]

DESCRIPTION
  Fetch the current ACTIVE document of a type, including markdown content. typeName uniquely implies the tenant (BETONIJERRY_TOS vs TOS) — no owner flag needed. --meta omits the (potentially >10 KB) content.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <typeName> STRING    Document type name (see ib legal types) (required)

FLAGS
  --meta    Omit markdownContent (returns contentLength instead)
  --language STRING    Document language: fi (binding original) or en (unofficial translation). The backend falls back to the fi row when no active en row exists for the type. (default: fi)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  {documentId, typeName, version, title, effectiveDate, markdownContent | contentLength, ...}

ERRORS (stderr, exit non-zero)
  exit 5 (HTTP 404)  No active document of this type → check ib legal versions <typeName>
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - The document body is the \`markdownContent\` field — NOT \`content\` or \`body\` (with --meta it is omitted and only \`contentLength\` is returned). \`ib legal get\` uses the same field name.

SEE ALSO
  ib legal types, ib legal versions

EXAMPLES
  ib legal show BETONIJERRY_TOS
  ib legal show TOS --meta
  ib legal show TOS --language en
"
`;

exports[`Help snapshots — contract stability > help for ib legal status matches snapshot 1`] = `
"USAGE
  ib legal status [flags]

DESCRIPTION
  Which legal documents you have accepted (version + timestamp) and which are still missing. Defaults to yourself and your token's company scope. --person requires developer/sysadmin (server-enforced). Content is stripped — read it via ib legal show. Entries under \`missing\` are active documents not yet accepted; an empty result means the scope has no active documents.
  Auth: requires login (any authenticated user).

FLAGS
  --person NUMBER    Check another personId (developer/sysadmin only)
  --owner NUMBER    ownerAsiakasId scope (default: your company from the token)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  {personId, ownerAsiakasId, requiresAcceptance, accepted: [{typeName, acceptedVersion, acceptedDate, ...}], missing: [...]}

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  --person on someone else without developer/sysadmin → drop --person or use a developer token
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib legal show, ib legal acceptances

EXAMPLES
  ib legal status
  ib legal status --person 6233
"
`;

exports[`Help snapshots — contract stability > help for ib legal type create matches snapshot 1`] = `
"USAGE
  ib legal type create --name <name> --display-name <display-name> [flags]

DESCRIPTION
  Create a new legal document TYPE (developer/sysadmin only). Types are the catalogue rows behind ib legal types; document versions attach to a type via ib legal save. --setting-type-id wires acceptance tracking — the id must exist in personSettingTypes and not be mapped to another type. --reason required unless --dry-run.
  Permissions: requires isSystemAdmin or isDeveloper (server-enforced).

FLAGS
  --name STRING    Type name, UPPER_SNAKE, max 50 (e.g. TOS_EN); immutable after creation (required)
  --display-name STRING    Human-readable name (max 100) (required)
  --description STRING    Short description (max 200)
  --sort-order NUMBER    List position (default 0)
  --setting-type-id NUMBER    personSettingTypeId for acceptance tracking (must exist and be unmapped)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED unless --dry-run.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  the created legalDocumentTypes row | dry-run: {dryRun: true, wouldCreateType: {...}, validation}

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Missing --reason / invalid or duplicate typeName / settingTypeId unknown or already mapped → check ib legal types; pass --reason unless --dry-run
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Developer/sysadmin only (server-enforced) → use a developer account token
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - typeName is immutable after creation — choose carefully.
  - Deploy-gated: 404 until the backend ships POST /api/legal-documents/types.

SEE ALSO
  ib legal type update, ib legal types, ib legal save

EXAMPLES
  ib legal type create --name TOS_EN --display-name "Terms of Service" --reason "publish EN docs"
  ib legal type create --name SLA_FI --display-name Palvelutasosopimus --setting-type-id 45 --dry-run
"
`;

exports[`Help snapshots — contract stability > help for ib legal type update matches snapshot 1`] = `
"USAGE
  ib legal type update <typeName> [flags]

DESCRIPTION
  Update a legal document TYPE's editable fields: displayName, description, sortOrder, personSettingTypeId (developer/sysadmin only). typeName itself is immutable; fields you do not pass are untouched. At least one field flag required. --reason required unless --dry-run.
  Permissions: requires isSystemAdmin or isDeveloper (server-enforced).

ARGUMENTS
  <typeName> STRING    Document type name (see ib legal types) (required)

FLAGS
  --display-name STRING    Human-readable name (max 100)
  --description STRING    Short description (max 200)
  --sort-order NUMBER    List position
  --setting-type-id NUMBER    personSettingTypeId for acceptance tracking (must exist in personSettingTypes and not be mapped to another type)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED unless --dry-run.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  the updated legalDocumentTypes row | dry-run: {dryRun: true, wouldUpdateType: {typeName, fields}, validation}

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Missing --reason / no field flags / settingTypeId unknown or already mapped to another type → pass at least one field flag and --reason unless --dry-run
  exit 5 (HTTP 404)  Unknown document type  → ib legal types
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Developer/sysadmin only (server-enforced) → use a developer account token
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Clearing a value to NULL is not supported.
  - Deploy-gated: 404 until the backend ships PUT /api/legal-documents/types/:typeName.

SEE ALSO
  ib legal type create, ib legal types, ib legal acceptances

EXAMPLES
  ib legal type update GLOBAL --setting-type-id 44 --reason "fix NULL mapping (feedback #31)"
  ib legal type update TOS_EN --display-name "Terms of Service v2" --dry-run
"
`;

