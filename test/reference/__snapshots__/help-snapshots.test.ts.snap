exports[`Help snapshots — contract stability > help for ib doctor matches snapshot 1`] = `
"USAGE
  ib doctor [flags]

DESCRIPTION
  Aggregated 'is my setup working' health check, and the first-contact orientation for MCP / \`/api/cli/exec\` callers (where the \`auth\` group — incl. \`auth whoami\` — is denied). Derives identity + tier + switchable companies from the active JWT (works for both file- and IB_TOKEN-sessions), reports token expiry, pings the public /api/version for connectivity + which build is live, and does ONE authenticated read to prove the token is accepted by this endpoint. Read-only. Exits 1 when the aggregate \`ok\` is false.
  Auth: requires login (any authenticated user).

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok:boolean, cli, endpoint, readOnly, auth:{ personId, email, tier:'developer'|'admin'|'standard', ownerAsiakasId, ownerAsiakasName, companies:{ asiakasId, roles }[], issuedFor, tokenExp, tokenExpired, impersonating?:{actorPersonId,sessionId} }, connectivity:VersionReport, authProbe:{ ok, status?, error? } } — \`tier\` = capability/discovery gate; \`companies\` = \`company switch\` targets; \`impersonating\` present only when the token acts as another person.

ERRORS (stderr, exit non-zero)
  exit 1 (client-side)  Not healthy            → inspect connectivity / authProbe / tokenExpired in the report
  exit 2 (client-side)  Not logged in          → ib auth login (or set IB_TOKEN)

EXAMPLES
  ib doctor
  ib doctor --endpoint https://api-staging.ibetoni.fi
"
`;

exports[`Help snapshots — contract stability > help for ib fennoa purchases matches snapshot 1`] = `
"USAGE
  ib fennoa purchases [flags]

DESCRIPTION
  Open purchase invoices (payables) fetched live from Fennoa — default target PumiNet Oy (asiakasId 26). System-admin only; result cached 15 min server-side.
  Permissions: requires isSystemAdmin.

FLAGS
  --all    Include settled invoices in the window, not only open (total_due > 0)
  --months NUMBER    Created-after window in months (default 6, max 12) (default: 6)
  --asiakas NUMBER    Target company override (e.g. 8 = Kalle Urho Oy verification path)
  --refresh    Bypass the server's 15-minute cache

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ id, supplierName, invoiceNumber, dueDate, totalDue, totalGross, paymentStatus, approvalStatus, ... }> & { summary: { count, totalDue, overdueCount, overdueTotal, oldestDueDate }, fetchedAt, asiakasId, months, cached? }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Not a system admin     → requires isSystemAdmin
  exit 4 (HTTP 424)  Fennoa credentials missing for the target company → add apiKeys rows (ownerAsiakasId + apiKeySourceId 16, USER/KEY) or use --asiakas 8
  exit 6 (HTTP 500)  Backend or Fennoa API error → retry with --verbose

NOTES
  - Live two-phase Fennoa fetch (list + per-invoice detail); 'open' = total_due > 0 — the Fennoa API has no unpaid filter.

EXAMPLES
  ib fennoa purchases
  ib fennoa purchases --asiakas 8 --months 2
  ib fennoa purchases --all --refresh
"
`;

exports[`Help snapshots — contract stability > help for ib glossary delete matches snapshot 1`] = `
"USAGE
  ib glossary delete <term> [flags]

DESCRIPTION
  Delete a glossary entry (developer only).
  Auth: requires login (any authenticated user).

ARGUMENTS
  <term> STRING    Canonical term (required)

FLAGS
  (none)

WRITE-SAFETY FLAGS
  --dry-run            CLIENT-side preview: resolves locally, no write reaches the wire (works under --read-only).
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { deleted: 0|1 } — rows removed; or { dryRun: true, term, wouldDelete: <entry>|null } with --dry-run

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  Not a developer        → Developer access required

NOTES
  - --dry-run resolves CLIENT-SIDE: it previews the entry that WOULD be deleted (via the miss-free ?search= endpoint) and never issues the DELETE — safe even before the backend guard deploys (the backend DELETE route ignored X-Dry-Run before this fix, so a --dry-run silently destroyed the entry).

EXAMPLES
  ib glossary delete obsolete-term --reason cleanup
  ib glossary delete obsolete-term --dry-run
"
`;

exports[`Help snapshots — contract stability > help for ib glossary dismiss matches snapshot 1`] = `
"USAGE
  ib glossary dismiss <term> [flags]

DESCRIPTION
  Dismiss an open lookup miss WITHOUT defining the term — for junk/test lookups (developer only). The term re-enters the queue if it is ever looked up again.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <term> STRING    Missed term (as listed by \`ib glossary misses\`) (required)

FLAGS
  (none)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { term, dismissed: 1 }; or { dryRun: true, term, wouldDismiss: boolean } with --dry-run

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  Not a developer        → Developer access required
  exit 5 (HTTP 404)  No OPEN miss for that term → Check \`ib glossary misses\` for the exact term

EXAMPLES
  ib glossary dismiss xa4 --reason junk
  ib glossary dismiss xa4 --dry-run
"
`;

exports[`Help snapshots — contract stability > help for ib glossary import matches snapshot 1`] = `
"USAGE
  ib glossary import <file> [flags]

DESCRIPTION
  Bulk create/update glossary entries from a JSON array file (developer only). Avoids shell argv mangling of Finnish ä/ö.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <file> STRING    JSON array file of {term, definition, synonyms?, relatedCommands?, relatedEntity?, domain?, aiConfidence?, needsHumanReview?} objects (or - for stdin) (required)

FLAGS
  --update-only    Only update existing terms; never insert

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { results: [{term, ok, error?}], ok, failed }

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  Not a developer        → Developer access required
  exit 4 (client-side)  File is not valid JSON or root is not an array → Check the file path and JSON syntax

NOTES
  - Each entry must have a \`term\` field; entries missing it are counted as failed.
  - Synonyms and relatedCommands may be arrays (arrays are accepted and converted to a comma list internally) or comma-separated strings.
  - Avoids shell argv mangling of Finnish ä/ö — pass UTF-8 JSON instead of quoting on the command line.
  - There is no --ai-confidence flag here, so a per-entry \`aiConfidence\` key is the ONLY way a bulk groom can carry its score. The backend resets that field on any write that omits it, so an entry without the key is stored unscored (and re-queued for grooming). Entry keys are honoured since fb#298 — before that fix import silently wiped the score of every term it touched.

EXAMPLES
  ib glossary import terms.json --reason "bulk groom"
  echo '[{"term":"loma","definition":"Vapaapaiva"}]' | ib glossary import - --reason "test"
"
`;

exports[`Help snapshots — contract stability > help for ib glossary lint matches snapshot 1`] = `
"USAGE
  ib glossary lint [flags]

DESCRIPTION
  Audit entries: dead relatedCommands, near-duplicate terms, empty fields (developer only).
  Auth: requires login (any authenticated user).

FLAGS
  --strict    Exit 1 if any warn-level finding exists (for CI)
  --suggest-related    Also emit stale-related suggestions: specs mentioning a term/synonym/entity but not yet linked (info-level)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ term, issue: 'dead-related'|'near-duplicate'|'empty-definition'|'no-anchor'|'synonym-collision'|'stale-related', detail, severity }>

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  Not a developer        → Developer access required

NOTES
  - --suggest-related is a grooming aid (fb#110): it proposes command paths whose path/flags/description mention the term (whole-word, >=4 chars), ranked path>flag>description, capped 6/term — review before adding, false positives are possible.

EXAMPLES
  ib glossary lint
  ib glossary lint --suggest-related
"
`;

exports[`Help snapshots — contract stability > help for ib glossary list matches snapshot 1`] = `
"USAGE
  ib glossary list [flags]

DESCRIPTION
  List glossary entries; --search filters by term/definition/synonym, --stalest orders least-recently-reviewed first.
  Auth: requires login (any authenticated user).

FLAGS
  --search STRING    Filter by substring
  --stalest NUMBER    Return up to N entries, stalest first
  --domain STRING    Filter to a domain (exact match)
  --related STRING    Filter to terms whose relatedCommands contain this substring
  --terms-only    Return only {term, synonyms} per entry — the cheap INDEX view (strips definitions); use to discover which terms exist.
  --needs-review    Only terms still needing grooming: aiConfidence below the threshold (or unassessed) AND not parked, oldest-first.
  --max-confidence NUMBER    Threshold for --needs-review (default 90).

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { items:[{term,synonyms,definition,relatedCommands:[{command,summary}],relatedEntity,domain,lastReviewed,runs,aiConfidence,needsHumanReview}], count, truncated? }

ERRORS (stderr, exit non-zero)
  exit 2 (client-side)  Not authenticated      → Run \`ib auth login\`

NOTES
  - --terms-only is client-side: it strips each row to {term, synonyms} after the server-side filters apply. Use it instead of a full list to discover terms cheaply (the full list returns every definition).

EXAMPLES
  ib glossary list
  ib glossary list --search puomi
  ib glossary list --stalest 10
  ib glossary list --domain vacation
  ib glossary list --terms-only
  ib glossary list --needs-review
"
`;

exports[`Help snapshots — contract stability > help for ib glossary lookup matches snapshot 1`] = `
"USAGE
  ib glossary lookup <term> [flags]

DESCRIPTION
  Resolve a Finnish/colloquial term or synonym to its definition + related commands (DB-backed). Exit 5 if undefined — the miss is recorded for the groomer.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <term> STRING    A word or synonym, e.g. pumppari (required)

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  single term: { term, synonyms[], definition, relatedCommands:[{command,summary}], relatedEntity } | batch (a,b,c): ListEnvelope<{ term, found, entry }>

ERRORS (stderr, exit non-zero)
  exit 5 (HTTP 404)  No entry for the term  → Try \`ib glossary list --search <term>\`; the miss is queued for definition
  exit 2 (client-side)  Not authenticated      → Run \`ib auth login\`

NOTES
  - Comma-separated terms (a,b,c) run a batch lookup returning a ListEnvelope of {term,found,entry}; a single term keeps the single-entry shape.

EXAMPLES
  ib glossary lookup pumppari
  ib glossary lookup betoniasema
  ib glossary lookup loma,saikku,pyhä
"
`;

