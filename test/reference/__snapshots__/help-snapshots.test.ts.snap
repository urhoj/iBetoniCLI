"
`;

exports[`Help snapshots — contract stability > help for ib dev cache invalidate matches snapshot 1`] = `
"USAGE
  ib dev cache invalidate <entityType> [flags]

DESCRIPTION
  Invalidate cache for one entity family by domain identifier (no Redis key knowledge needed). Previews (X-Dry-Run) unless --confirm. --cascade fans out to related families (keikka only). Any admin; non-developers are scoped to their own company. Guard: refuses deployed endpoints unless --force-prod (all slots share Redis DB 3).
  Permissions: requires admin role (SystemAdmin, AsiakasAdmin, or LaskuAdmin) or developer.

ARGUMENTS
  <entityType> STRING    Entity family, e.g. keikka/asiakas/vehicle (see \`ib dev cache entities\`) (required)

FLAGS
  --id NUMBER    Entity id (e.g. keikkaId)
  --asiakas NUMBER    Tenant scope (developers may target others; non-devs use their own)
  --cascade    Also invalidate related families (keikka only)
  --confirm    Execute the operation (default is dry-run preview)
  --dry-run    Preview without deleting — the DEFAULT here, so this flag is an explicit no-op. Accepted because it is the CLI-wide preview spelling; this group inverts the usual idiom and previews unless --confirm. Passing it WITH --confirm exits 4 rather than picking a winner.
  --force-prod    Execute against a deployed (shared-cache) backend. Sent as X-Force-Prod: 1; a deployed backend refuses destructive cache ops without it (403) — including calls routed via /api/cli/exec and MCP ib_exec.
  --reason STRING    Audit-log reason (X-Action-Reason)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  preview: { dryRun:true, wouldDelete, patterns[] } | execute: { dryRun:false, deleted }

ERRORS (stderr, exit non-zero)
  exit 4 (HTTP 400)  Unknown entityType or cascade unsupported → run \`ib dev cache entities\` to list valid types
  exit 3 (HTTP 403)  Not an admin, or cross-tenant entity needs developer → cross-tenant entities (keikka, grid, stat, attachment) require isSystemAdmin/isDeveloper; others need an admin role
  exit 3 (client-side)  Refused: deployed endpoint without --force-prod → prod and staging share Redis DB 3; add --force-prod or use a local endpoint
  exit 3 (client-side)  Blocked by read-only mode → executing a cache write needs --confirm and a session without --read-only/IB_READ_ONLY (previews still work)
  exit 4 (client-side)  --dry-run and --confirm passed together → drop --dry-run to execute, or drop --confirm to preview (preview is the default)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Without --confirm the command only PREVIEWS (counts keys) and never deletes.
  - This group INVERTS the CLI-wide write-safety idiom: elsewhere a write performs by default and --dry-run previews; here it previews by default and --confirm performs. --dry-run is accepted as an explicit spelling of that default so the two idioms compose.
  - Single-entity invalidate may leave related caches (grid/stepLog/attachments) stale — use --cascade (keikka) or invalidate each family.

SEE ALSO
  ib dev cache entities, ib dev cache keys

EXAMPLES
  ib dev cache invalidate keikka --id 123
  ib dev cache invalidate keikka --id 123 --cascade --confirm
  ib dev cache invalidate asiakas --asiakas 8 --confirm
"
`;

exports[`Help snapshots — contract stability > help for ib dev cache keys matches snapshot 1`] = `
"USAGE
  ib dev cache keys [flags]

DESCRIPTION
  Key counts grouped by prefix pattern (SCAN). Developer-only.
  Permissions: requires isSystemAdmin or isDeveloper.

FLAGS
  --pattern STRING    SCAN match glob (default: *) (default: *)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { totalKeys, groups: [{ prefix, count }] }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Not a developer        → requires isSystemAdmin or isDeveloper
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib dev cache keys
  ib dev cache keys --pattern 'keikka:*'
"
`;

exports[`Help snapshots — contract stability > help for ib dev cache pattern matches snapshot 1`] = `
"USAGE
  ib dev cache pattern [<glob>] [flags]

DESCRIPTION
  Invalidate keys matching a raw Redis glob. Previews unless --confirm. Guard: refuses deployed endpoints unless --force-prod. Developer-only. Prefer \`ib dev cache invalidate\` (domain entity); use \`ib dev cache keys\` to find the right glob.
  Permissions: requires isSystemAdmin or isDeveloper.

ARGUMENTS
  <glob> STRING    Raw Redis key glob (e.g. 'keikka:*'). Alias: --pattern <glob>, matching the spelling the sibling \`ib dev cache keys\` uses for the same concept — exactly one is required, both only if they agree. (optional)

FLAGS
  --pattern STRING    Raw Redis key glob (alias for the positional)
  --confirm    Execute the operation (default is dry-run preview)
  --dry-run    Preview without deleting — the DEFAULT here, so this flag is an explicit no-op. Accepted because it is the CLI-wide preview spelling; this group inverts the usual idiom and previews unless --confirm. Passing it WITH --confirm exits 4 rather than picking a winner.
  --force-prod    Execute against a deployed (shared-cache) backend. Sent as X-Force-Prod: 1; a deployed backend refuses destructive cache ops without it (403) — including calls routed via /api/cli/exec and MCP ib_exec.
  --reason STRING    Audit-log reason (X-Action-Reason)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  preview: { dryRun:true, wouldDelete, pattern, sampleKeys } | execute: { deleted, pattern }. When wouldDelete is 0 the preview ALSO carries { totalKeys, existingPrefixes[], hint } — a zero alone cannot tell 'cache is clean' from 'your glob is wrong', so those fields settle it without a second command (feedback #431).

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Not a developer        → requires isSystemAdmin or isDeveloper
  exit 6 (HTTP 500)  Backend error          → retry with --verbose
  exit 3 (client-side)  Refused: deployed endpoint without --force-prod → prod and staging share Redis DB 3; add --force-prod or use a local endpoint
  exit 3 (client-side)  Blocked by read-only mode → executing a cache write needs --confirm and a session without --read-only/IB_READ_ONLY (previews still work)
  exit 4 (client-side)  --dry-run and --confirm passed together → drop --dry-run to execute, or drop --confirm to preview (preview is the default)
  exit 4 (client-side)  No glob given, positionally or via --pattern → pass the glob positionally (\`ib dev cache pattern 'keikka:*'\`) or as --pattern 'keikka:*'
  exit 4 (client-side)  The positional glob and --pattern were both given and disagree → pass the glob ONCE — only one of the two could be honoured, so the CLI refuses rather than silently picking

EXAMPLES
  ib dev cache pattern 'keikka:*'
  ib dev cache pattern --pattern 'keikka:*'
  ib dev cache pattern 'person:*' --confirm --force-prod
"
`;

