                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { success: true }

ERRORS (stderr, exit non-zero)
  exit 5 (HTTP 404)  Sijainti not found     → verify sijaintiId
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.sijainnit.delete
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib sijainti delete 42 --reason "decommissioned depot"
"
`;

exports[`Help snapshots — contract stability > help for ib sijainti distance matches snapshot 1`] = `
"USAGE
  ib sijainti distance [flags]

DESCRIPTION
  Driving distance and time between two points (Google Maps). Each endpoint is either 'lat,lng' or a sijaintiId (resolved to its coordinates). ownerAsiakasId is derived from the active company.
  Permissions: requires auth.page.sijainnit.read.

FLAGS
  --from STRING    Origin: 'lat,lng' or a sijaintiId (REQUIRED)
  --to STRING    Destination: 'lat,lng' or a sijaintiId (REQUIRED)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { matkaM: number|null, matkaMin: number|null, from:{lat,lng}, to:{lat,lng} }

ERRORS (stderr, exit non-zero)
  exit 4 (HTTP 400)  Bad point or sijainti without coordinates → use 'lat,lng' or a sijaintiId that has coords
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.sijainnit.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib sijainti distance --from 7 --to 42
  ib sijainti distance --from "60.17,24.94" --to 42
"
`;

exports[`Help snapshots — contract stability > help for ib sijainti geocode matches snapshot 1`] = `
"USAGE
  ib sijainti geocode [flags]

DESCRIPTION
  Geocode a free-form address to coordinates via Google Maps. Useful before \`sijainti create\` to obtain lat/lng. ownerAsiakasId is derived from the token.
  Permissions: requires auth.page.sijainnit.read.

FLAGS
  --address STRING    Free-form address (REQUIRED)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { geocoded:boolean, lat|null, lng|null, placeId|null, formattedAddress|null, status, results[] }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.sijainnit.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - The flat fields are the SAME shape \`ib jerry check-address\` returns (geocoded/lat/lng/placeId/formattedAddress), so one parser reads both. The raw Google payload is retained as \`results[]\` for callers that need address_components, viewport, or location_type.
  - No match is \`geocoded:false\` with exit 0, not an error — the address not existing is an answer. Always read \`status\` alongside it: ZERO_RESULTS means Google found nothing (or the address was shorter than 5 characters), while TEST_ADDRESS / GOOGLE_MAPS_TIMEOUT / GOOGLE_MAPS_API_ERROR mean the lookup never happened. Treating a bare geocoded:false as 'no such address' hides a service failure.

SEE ALSO
  ib jerry check-address

EXAMPLES
  ib sijainti geocode --address "Mannerheimintie 1, Helsinki"
"
`;

