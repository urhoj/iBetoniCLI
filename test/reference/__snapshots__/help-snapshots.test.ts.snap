exports[`Help snapshots — contract stability > help for ib opendata weather toggle matches snapshot 1`] = `
"USAGE
  ib opendata weather toggle [flags]

DESCRIPTION
  Enable or disable the weather module for the active company. Pass exactly one of --on or --off. Admin-scoped operation. Supports --dry-run, --idempotency-key, and --reason for audit trail.
  Auth: requires login (any authenticated user).

FLAGS
  --on    Enable the module
  --off    Disable the module

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { success: boolean, enabled: boolean, ... }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Neither --on nor --off passed, or both passed → pass exactly one of --on / --off
  exit 3 (HTTP 403)  Permission denied (admin required) → requires admin role on the company
  exit 2 (HTTP 401)  Not authenticated      → run 'ib auth login'
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib opendata weather toggle --on --reason 'enabling for summer season'
  ib opendata weather toggle --off --dry-run
"
`;

