exports[`Help snapshots — contract stability > help for ib dev ai conversation matches snapshot 1`] = `
"USAGE
  ib dev ai conversation <conversationId> [flags]

DESCRIPTION
  Fetch the full transcript of an /ai assistant conversation by id (gptConversations/gptMessages). Developer/sysadmin tooling. Get an id by browsing with \`ib dev ai conversations\`, or from an \`ib feedback\` row's context.conversationId — stamped automatically when the AI files feedback from the /ai page.
  Permissions: requires isSystemAdmin or isDeveloper.

ARGUMENTS
  <conversationId> NUMBER    gptConversations id (from \`ib dev ai conversations\` or a feedback row's context.conversationId) (required)

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { conversationId, personId, ownerAsiakasId, messageCount, messages: [{ gptMessageId, keikkaId, role?, content?, raw?, ... }] }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Validation             → conversationId must be a positive integer
  exit 3 (HTTP 403)  Permission denied      → requires a developer token (isSystemAdmin/isDeveloper)
  exit 5 (HTTP 404)  Not found              → no conversation with that id
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Cross-tenant by design: the transcript is readable whatever the caller's active company, because the AI fixer triages \`ib feedback\` rows from any tenant. Transcripts may contain PII — hence the developer gate.
  - Each message is { gptMessageId, keikkaId, ...JSON.parse(gptMessages.message) } — normally role/content, but a row whose stored message is NOT valid JSON falls back to { gptMessageId, keikkaId, raw }. Handle \`raw\` as well as \`content\`.

SEE ALSO
  ib dev ai conversations, ib dev feedback get, ib dev feedback list

EXAMPLES
  ib dev ai conversation 4321
"
`;

exports[`Help snapshots — contract stability > help for ib dev ai conversations matches snapshot 1`] = `
"USAGE
  ib dev ai conversations [flags]

DESCRIPTION
  List recent /ai assistant conversations CROSS-TENANT for audit/browse (compact rows, newest-first, no message bodies). Developer/sysadmin tooling — the way to discover conversationIds to audit without an \`ib feedback\` row pointing at one. Drill into a transcript with \`ib dev ai conversation <id>\`.
  Permissions: requires isSystemAdmin or isDeveloper.

FLAGS
  --limit NUMBER    Max rows to return (1-100) (default: 20)
  --person NUMBER    Filter to one person's conversations (personId)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ conversationId, personId, ownerAsiakasId, entryTime, messageCount }> (truncated:true when the page hit --limit)

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Validation             → --limit must be 1-100; --person must be a positive integer
  exit 3 (HTTP 403)  Permission denied      → requires a developer token (isSystemAdmin/isDeveloper)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Cross-tenant by design: rows from EVERY tenant are returned and the active --company does NOT narrow them (each row carries its own ownerAsiakasId). Transcripts may contain PII — hence the developer gate.
  - Excludes archived conversations (gptConversations.isArchived=1) and conversations with zero messages, so an id taken from a feedback row can legitimately be absent here while \`ib dev ai conversation <id>\` still returns it.
  - No cursor: nextCursor is always null. truncated:true means the page filled --limit — raise --limit (max 100) rather than trying to page.

SEE ALSO
  ib dev ai conversation, ib dev feedback list

EXAMPLES
  ib dev ai conversations
  ib dev ai conversations --limit 50
  ib dev ai conversations --person 6233
"
`;

exports[`Help snapshots — contract stability > help for ib dev cache clear matches snapshot 1`] = `
"USAGE
  ib dev cache clear [flags]

DESCRIPTION
  Flush the entire Redis cache (curated sweep; preserves sessions/locks/metrics). Previews (X-Dry-Run) unless --confirm. Cross-tenant: clears every company's cached data. Guard: refuses deployed endpoints unless --force-prod. Developer-only.
  Permissions: requires isSystemAdmin or isDeveloper.

FLAGS
  --confirm    Execute the operation (default is dry-run preview)
  --dry-run    Preview without deleting — the DEFAULT here, so this flag is an explicit no-op. Accepted because it is the CLI-wide preview spelling; this group inverts the usual idiom and previews unless --confirm. Passing it WITH --confirm exits 4 rather than picking a winner.
  --force-prod    Execute against a deployed (shared-cache) backend. Sent as X-Force-Prod: 1; a deployed backend refuses destructive cache ops without it (403) — including calls routed via /api/cli/exec and MCP ib_exec.
  --reason STRING    Audit-log reason (X-Action-Reason)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  preview: { dryRun:true, wouldDelete } | execute: { deleted }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Not a developer        → requires isSystemAdmin or isDeveloper
  exit 6 (HTTP 500)  Backend error          → retry with --verbose
  exit 3 (client-side)  Refused: deployed endpoint without --force-prod → prod and staging share Redis DB 3; add --force-prod or use a local endpoint
  exit 3 (client-side)  Blocked by read-only mode → executing a cache write needs --confirm and a session without --read-only/IB_READ_ONLY (previews still work)
  exit 4 (client-side)  --dry-run and --confirm passed together → drop --dry-run to execute, or drop --confirm to preview (preview is the default)

EXAMPLES
  ib dev cache clear
  ib dev cache clear --confirm --force-prod
"
`;

