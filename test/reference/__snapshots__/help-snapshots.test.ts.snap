exports[`Help snapshots — contract stability > help for ib company list matches snapshot 1`] = `
"USAGE
  ib company list [flags]

DESCRIPTION
  List the companies the current user can act on — name, the roles held there, and the active one marked \`current: true\`. The one-call answer to 'where can I act, as what'.
  Auth: requires login (any authenticated user).

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ asiakasId, name, current, roles }> = { items, nextCursor, count }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - \`roles\` are read from your own JWT, so they cost no extra round-trip. \`[]\` = membership with no roles (a real state), not an error.
  - \`ib auth whoami\` reports the same memberships but names only the ACTIVE company — use this command when you need the names.

SEE ALSO
  ib auth whoami, ib company switch

EXAMPLES
  ib company list
  ib company list --pretty
"
`;

exports[`Help snapshots — contract stability > help for ib company switch matches snapshot 1`] = `
"USAGE
  ib company switch [flags]

DESCRIPTION
  Switch the active company. Alias of \`ib auth switch\`. Persists the rotated JWT.
  Auth: requires login (any authenticated user).

FLAGS
  --to NUMBER    Target asiakasId to switch to

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true, activeCompany: { asiakasId, name } }

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  No access to target    → verify via \`ib company list\`
  exit 3 (client-side)  Read-only mode active (--read-only / IB_READ_ONLY) → persisted switch is blocked under read-only; use the per-command global --company <id> ephemeral context
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Persists a rotated JWT bound to the target company — blocked under read-only mode (exit 3).
  - For a one-command company context that does NOT persist, use the global \`--company <id>\` flag instead.

EXAMPLES
  ib company switch --to 1349
"
`;

