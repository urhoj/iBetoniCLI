exports[`Help snapshots — contract stability > help for ib keikka get matches snapshot 1`] = `
"USAGE
  ib keikka get <keikkaId> [flags]
  (also: ib keikka show)

DESCRIPTION
  Get a single keikka by id with related customer / worksite / vehicle / driver projections.
  Permissions: requires auth.page.grid.tilaus.read.

ARGUMENTS
  <keikkaId> NUMBER    keikkaId to fetch (required)

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { keikkaId, ownerAsiakasId, pvm, time, customer:{asiakasId,name}|null, worksite:{tyomaaId,address}|null, vehicle:{vehicleId,plate}|null, driver:{personId,name}|null, m3, status }

ERRORS (stderr, exit non-zero)
  exit 5 (HTTP 404)  Keikka not found OR outside your visible scope → verify keikkaId — but note this is NOT proof the row is absent: results mirror your permissions, so an existing keikka in another tenant 404s identically
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.grid.tilaus.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - A 404 answers 'can I see it', not 'does it exist' — every command mirrors the caller's permissions, so a keikka owned by another tenant is indistinguishable from a keikkaId that was never issued. Do NOT read it as a typo. To settle existence you need a caller whose scope could see it: \`ib company switch\` to the owning tenant, or a system-admin/developer token (feedback #427).

EXAMPLES
  ib keikka get 9001
"
`;

exports[`Help snapshots — contract stability > help for ib keikka latest matches snapshot 1`] = `
"USAGE
  ib keikka latest [flags]

DESCRIPTION
  The single most recent keikka matching the filters — no date range needed. Answers 'when was the latest delivered order?' in one command by searching backwards from today.
  Permissions: requires auth.page.grid.tilaus.read.

FLAGS
  --status STRING    Filter by status (keikkaTilaId — e.g. 9 = Toimitettu; see the \`tila\` GLOSSARY legend)
  --customer NUMBER    Filter by asiakasId
  --vehicle NUMBER    Filter by vehicleId
  --worksite NUMBER    Filter by worksite (tyomaaId)
  --lookback NUMBER    How far back from today to search, in days (max 3650) (default: 365)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { item: { keikkaId, pvm, asiakasId, tyomaaId, vehicleId, tila, m3, time } | null, searched: { from, to } }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.grid.tilaus.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Client-side windowed search over \`keikka list\`: walks 7/30/90/365-day windows backwards from today until a window has matches (a handful of round-trips at most). \`item: null\` + the \`searched\` range echo = genuinely nothing within --lookback.
  - Windows truncated at the 500-row server cap are halved toward their newest end, so the true latest row cannot be hidden by truncation.
  - Statuses 9/12/13 are all 'Toimitettu' — query the one you mean (no multi-status filter in v1).

SEE ALSO
  ib keikka list, ib keikka get

EXAMPLES
  ib keikka latest
  ib keikka latest --status 9
  ib keikka latest --customer 1349 --lookback 730
"
`;

exports[`Help snapshots — contract stability > help for ib keikka list matches snapshot 1`] = `
"USAGE
  ib keikka list [flags]

DESCRIPTION
  List concrete delivery orders (keikkas) for the active company within a date range. Flat envelope optimised for AI/CI consumption.
  Permissions: requires auth.page.grid.tilaus.read.
  Timezone: dates interpreted in active company timezone (Europe/Helsinki).

FLAGS
  --from DATE    Start date (YYYY-MM-DD or today/yesterday/tomorrow) (default: today)
  --to DATE    End date (YYYY-MM-DD or today/yesterday/tomorrow) (default: today)
  --date DATE    Single-day shorthand: sets --from and --to to this one day (YYYY-MM-DD or today/yesterday/tomorrow). Mutually exclusive with --from/--to.
  --customer NUMBER    Filter by asiakasId
  --vehicle NUMBER    Filter by vehicleId
  --worksite NUMBER    Filter by worksite (tyomaaId)
  --status STRING    Filter by tila/status
  --limit NUMBER    Max rows. Omitting it sends no limit param — the backend applies the default 100 server-side (caps at 500) (default: 100)
  --cursor STRING    Pagination cursor

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ keikkaId, pvm, asiakasId, tyomaaId, vehicleId, tila, m3, time }> & { range: { from, to } } (the interpreted date window, echoed so an empty result is verifiably scoped). On an empty result the envelope also carries a \`hint\` explaining the count:0 (permitted-but-empty vs how to widen).

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this command caps at 500 — page past it with \`--cursor\` from the previous response's \`nextCursor\`, or narrow with \`--from\` / \`--to\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.grid.tilaus.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - \`tila\` is the numeric keikkaTilaId. Legend: -1 Uusi tilaus · 0 Luonnos (draft) · 1 Kesken · 2 Lähetetty (sent) · 3 Käsittelyssä · 4 Toimitusvalmis · 5 Toimitus meneillään · 6 Toimitus epäonnistui · 7 Epäonnistui · 8 Peruttu (cancelled) · 9/12/13 Toimitettu (delivered) · 10 Poistettu (deleted) · 100 Valmis (complete) · 11/200 Järjestelmätilaus (system, do not edit).
  - The same legend is in the GLOSSARY (\`tila\`) on \`ib --help\`; source of truth: GET /api/tila/list.
  - A keikka spanning multiple worksites returns ONE ROW PER tyomaa (join fan-out): the same keikkaId can appear on several rows with different tyomaaId, and \`count\` counts ROWS, not distinct deliveries — dedupe by keikkaId when counting deliveries.
  - Default window is TODAY only (--from/--to both default to today). A count:0 with exit 0 is a permitted query that found no data in that window — NOT an access error (denial is exit 3 / HTTP 403); the envelope's \`hint\` says so. Widen with --from/--to, or use \`ib keikka latest\` (bounded by --lookback, default 365d).

SEE ALSO
  ib keikka latest

EXAMPLES
  ib keikka list --from 2026-05-28 --to 2026-05-30
  ib keikka list --date today
  ib keikka list --from 2026-05-01 --to 2026-05-31 --customer 1349 --status 9 --limit 50
  ib keikka list --from today --to tomorrow --pretty
"
`;

exports[`Help snapshots — contract stability > help for ib keikka log matches snapshot 1`] = `
"USAGE
  ib keikka log <keikkaId> [flags]

DESCRIPTION
  Change-tracker audit trail for one keikka — who changed which field, when, old→new, with --reason. Folds in the keikka's keikkaBetoni (concrete-line) rows. Alias of \`ib log entity keikka\`. GET /api/changes/keikka/:keikkaId/:ownerAsiakasId.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <keikkaId> NUMBER    keikkaId (required)

FLAGS
  --owner NUMBER    ownerAsiakasId (default: active company; a non-integer value exits 4 client-side)
  --limit NUMBER    Max rows (capped at 500) (default: 100)
  --field STRING    Filter by fieldName (e.g. kuskit, laskuMemo, keikkaTilaId)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ changeId, entityType, entityId, field, oldValue, newValue, changeType, personId, personName, at, description, reason, impersonatedByPersonName, keikkaTilaContext, deviceType }> (+truncated:true when the page filled --limit — cursor-less route, so a full page may hide older rows) (+hint when --field filtered a capped page: the filter saw only the newest --limit rows)

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this cursor-less route caps at 500 — raise --limit to reach older rows (\`--field\` only narrows the page you already fetched)
  exit 3 (HTTP 403)  Not a member of that company (and not admin) → ib company switch to that owner, or use an admin token
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib log entity, ib log by-entity-date

EXAMPLES
  ib keikka log 12345
  ib keikka log 12345 --field kuskit
"
`;

exports[`Help snapshots — contract stability > help for ib keikka person list matches snapshot 1`] = `
"USAGE
  ib keikka person list [<keikkaId>] [flags]

DESCRIPTION
  List the persons attached to a keikka as RAW keikkaPerson rows — one row per link, with the source id resolved to its source text. The SAME person legitimately holds several rows (one per source), so use --by-person to fold them per person, or --count for the per-source totals when a keikka carries a surprising number of rows.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <keikkaId> NUMBER    keikkaId (or pass --keikka) (optional)

FLAGS
  --keikka NUMBER    Target keikkaId (alias for the positional)
  --source NUMBER    Only rows with this keikkaPersonSourceId (applies to every mode)
  --by-person    Collapse rows per person (rowCount, sources[], auth flags OR-ed). Mutually exclusive with --count.
  --count    Only { summary }: total, distinctPersons, bySource counts. Mutually exclusive with --by-person.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  default: ListEnvelope<{ keikkaPersonId, personId, name, email, phone, sourceId, sourceText, contactType, entryTime, authRead, authEdit, authListPersons, authAddPerson, authEditPerson }> · --by-person: ListEnvelope<{ personId, name, email, phone, rowCount, sources:[{sourceId,sourceText}], contactTypes:[], auth:{read,edit,listPersons,addPerson,editPerson} }> · --count: { summary: { total, distinctPersons, bySource:[{sourceId,sourceText,count}] } }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  No company role on the keikka's owner company and no delegated authEdit grant on the keikka — the gate fails CLOSED, so a nonexistent keikkaId denies identically for non-sysadmin callers → verify the keikkaId; \`ib company switch\` to the keikka's owner, or use a sysadmin/developer token
  exit 5 (HTTP 404)  The route itself never 404s — a 404 here means GET /api/cli/keikka/persons is not deployed yet (deploy-gated) → deploy the backend (npm run deploy + swap), then retry
  exit 4 (client-side)  Both collapse modes passed together → pass exactly one of --by-person or --count
  exit 4 (client-side)  No keikkaId given (or not a positive integer) → pass <keikkaId> positionally or via --keikka <id>
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Gate = requireKeikkaManageAccess (same as the FE route): sysadmin/developer, any company role on the keikka's OWNER, or a delegated authEdit grant — delegated read-only is NOT enough.
  - RAW is the default ON PURPOSE: one person holds one row per source, and a silent collapse would hide exactly the bloat this command diagnoses (fb#833). --by-person is the opt-in fold.
  - Source ids resolve to text server-side (dbo.keikkaPersonSource); typical: 1 created-by, 10/11 asiakas mirror/contact, 20/21 tyomaa mirror/contact, 30/31 manual/keikka contact, 50 pumppari.
  - Deleted links (isDeleted=1) and system persons (personId<=0) are excluded server-side.
  - Deploy-gated: 404 until the backend ships GET /api/cli/keikka/persons.

SEE ALSO
  ib keikka get, ib customer person list, ib worksite person list

EXAMPLES
  ib keikka person list 9096
  ib keikka person list --keikka 9096 --by-person
  ib keikka person list 9096 --count
  ib keikka person list 9096 --source 30
"
`;

exports[`Help snapshots — contract stability > help for ib keikka search matches snapshot 1`] = `
"USAGE
  ib keikka search [<query>] [flags]

DESCRIPTION
  Search keikkas via the backend full-text search: phone number, keikkaId, worksite name/number, invoice reference. Returns deduped hits (one per keikka), newest first.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <query> STRING    Full-text search string (phone, keikkaId, worksite name/number, invoice ref) — or pass --search (optional)

FLAGS
  --search STRING    Search query (alias for the <query> positional)
  --limit NUMBER    Max hits (client-side; backend caps at 100)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ keikkaId, title, pumppuAika, customerName, worksiteName, address, contactPerson, contactPhone }>

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Backed by the deployed GET /api/keikka/search (same path the AI order tool uses) — no deploy gate.
  - Scope: the active company (ownerAsiakasId from the session token).

EXAMPLES
  ib keikka search 0401234567
  ib keikka search "As Oy Esimerkki" --limit 3
"
`;

exports[`Help snapshots — contract stability > help for ib keikka update matches snapshot 1`] = `
"USAGE
  ib keikka update <keikkaId> [flags]

DESCRIPTION
  Update a keikka. v1.0 supports only \`--status\` (the numeric keikkaTilaId, posted to POST /api/keikka/tila/set). Other field-setters land in v1.1.
  Permissions: requires auth.page.grid.tilaus.edit.

ARGUMENTS
  <keikkaId> NUMBER    keikkaId to update (required)

FLAGS
  --status STRING    New keikkaTilaId (numeric, e.g. 9 = Toimitettu)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { ok: true } or backend response

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  No field flags given at all → pass --status <keikkaTilaId> — it is the only field v1.0 can update
  exit 4 (client-side)  --status not a numeric keikkaTilaId → pass a number, e.g. --status 9
  exit 5 (HTTP 404)  Keikka not found OR outside your visible scope → verify keikkaId — but note this is NOT proof the row is absent: results mirror your permissions, so an existing keikka in another tenant 404s identically
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.grid.tilaus.edit
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - --status takes the numeric keikkaTilaId, NOT a name — e.g. \`--status 9\` (Toimitettu), \`--status 8\` (Peruttu), \`--status 2\` (Lähetetty). See the legend on \`ib keikka list --help\` or the \`tila\` GLOSSARY entry on \`ib --help\`.

EXAMPLES
  ib keikka update 9001 --status 9
  ib keikka update 9001 --status 8 --reason 'phone cancellation'
"
`;

exports[`Help snapshots — contract stability > help for ib keikka validate matches snapshot 1`] = `
"USAGE
  ib keikka validate [<keikkaId>] [flags]

DESCRIPTION
  Validate a keikka (or a whole day with --date) against the reminders-drawer rules
  Permissions: requires auth.page.grid.tilaus.read.
  Timezone: dates interpreted in active company timezone (Europe/Helsinki).

ARGUMENTS
  <keikkaId> NUMBER    keikkaId to validate (omit when using --date) (optional)

FLAGS
  --date DATE    Validate every keikka for this date (YYYY-MM-DD or today/yesterday/tomorrow)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  single: { keikkaId, isValid, validationEnabled, summary:{totalIssues,critical,high,medium,low,notification,categories}, issues:[{type,message,priority,priorityName,category,categoryName,field}] } | day: { items:[{ keikkaId, isValid, summary, issues }], count, dayTotals:{totalIssues,critical,invalidKeikkas}, validationEnabled }

ERRORS (stderr, exit non-zero)
  exit 5 (HTTP 404)  Keikka not found OR outside your visible scope → verify keikkaId — but note this is NOT proof the row is absent: results mirror your permissions, so an existing keikka in another tenant 404s identically
  exit 4 (HTTP 400)  Bad date / keikkaId    → use YYYY-MM-DD or a positive integer
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.grid.tilaus.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - validationEnabled is the per-company grid master toggle; rules run regardless. Single 404 if the keikka is not visible; day mode validates every keikka for the date.

SEE ALSO
  ib validate, ib keikka get

EXAMPLES
  ib keikka validate 9001
  ib keikka validate --date today
"
`;

exports[`Help snapshots — contract stability > help for ib legal accept matches snapshot 1`] = `
"USAGE
  ib legal accept [<typeName>] [flags]

DESCRIPTION
  Record YOUR OWN acceptance of the current active version of a type. DEVELOPER TESTING AID, gated client-side to developer/sysadmin tokens — real consent is a human action recorded via the betoni.online / betonijerry.fi UI flows. The backend endpoint is self-only: you can never accept on someone else's behalf. --reason required unless --dry-run.
  Permissions: requires isSystemAdmin or isDeveloper (client-side gate).

ARGUMENTS
  <typeName> STRING    Document type name (see ib legal types; or pass --type) (optional)

FLAGS
  --type STRING    Document type name (alias for the positional)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED unless --dry-run.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  {success} | dry-run: {dryRun: true, wouldAccept: {...}, validation}

ERRORS (stderr, exit non-zero)
  exit 3 (client-side)  Not a developer/sysadmin token (client-side gate) → use a developer account
  exit 4 (client-side)  Missing typeName / missing --reason / type has no personSettingTypeId mapping → pass <typeName> and --reason; check ib legal types
  exit 5 (HTTP 404)  No active document of this type → ib legal versions <typeName>
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Resolves the active version via two sequential reads (current + types); if another developer activates a new version between them, the recorded version string can be one step stale. Acceptable for a testing aid — verify with ib legal status afterwards.

SEE ALSO
  ib legal status, ib legal show

EXAMPLES
  ib legal accept BETONIJERRY_TOS --reason "acceptance flow e2e test"
  ib legal accept TOS --dry-run
"
`;

exports[`Help snapshots — contract stability > help for ib legal acceptances matches snapshot 1`] = `
"USAGE
  ib legal acceptances <typeName> [flags]

DESCRIPTION
  Compliance report (developer/sysadmin only): WHO has accepted a document type — personId, name, email, accepted version + timestamp, newest first. Capped at 500 rows with a truncated flag. Types with NULL personSettingTypeId (e.g. GLOBAL today) are not trackable and return a validation error.
  Permissions: requires isSystemAdmin or isDeveloper (server-enforced).

ARGUMENTS
  <typeName> STRING    Document type name (see ib legal types) (required)

FLAGS
  --doc-version STRING    Only acceptances of this version string (NOT --version — that is the global CLI version flag)
  --limit NUMBER    Max rows (cap 500) (default: 500)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{personId, firstName, lastName, email, acceptedVersion, acceptedAt}> & {typeName, personSettingTypeId, truncated?}

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this command caps at 500 — narrow with \`--doc-version\` rather than raising the cap
  exit 4 (HTTP 400)  Type has no personSettingTypeId mapping → fix the legalDocumentTypes row first
  exit 5 (HTTP 404)  Unknown document type  → ib legal types
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Developer/sysadmin only (server-enforced) → use a developer account token
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib legal status, ib legal types

EXAMPLES
  ib legal acceptances BETONIJERRY_TOS
  ib legal acceptances TOS --doc-version 2.0
"
`;

exports[`Help snapshots — contract stability > help for ib legal activate matches snapshot 1`] = `
"USAGE
  ib legal activate <documentId> [flags]

DESCRIPTION
  Publish a document version (developer/sysadmin only): atomically archives the current active version of the same type+tenant (status='archived') and activates this one (status='active', isActive=1; also stamps effectiveDate). Use to publish a draft or roll back to an earlier version.
  Permissions: requires isSystemAdmin or isDeveloper (server-enforced).

ARGUMENTS
  <documentId> NUMBER    legalDocuments.documentId to activate (required)

FLAGS
  (none)

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED unless --dry-run.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  {success} | dry-run: {dryRun: true, wouldActivate: {documentId}, validation}

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Missing --reason or invalid documentId → pass --reason 'why' (not needed with --dry-run)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Developer/sysadmin only (server-enforced) → use a developer account token
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib legal save, ib legal versions

EXAMPLES
  ib legal activate 12 --reason "publish v2.1"
"
`;

exports[`Help snapshots — contract stability > help for ib legal active matches snapshot 1`] = `
"USAGE
  ib legal active [flags]
  (also: ib legal list)

DESCRIPTION
  Roll-up of the current ACTIVE document of EVERY type in one call — the single-view answer to 'what legal text is live right now'. One row per type: types with no active version appear with hasActive:false (not dropped). Content is stripped (contentLength only) — read a body via ib legal show <typeName>. Client-side fan-out over ib legal types + ib legal show.
  Auth: requires login (any authenticated user).

FLAGS
  --language STRING    Document language applied to every per-type fetch: fi (binding original) or en (unofficial translation, falls back to fi where no active en row exists). (default: fi)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{typeName, displayName, personSettingTypeId, hasActive, documentId, version, title, effectiveDate, contentLength}>

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Also reachable as \`ib legal list\` (alias) — \`active\` is the legal group's analog of other domains' \`list\`.

SEE ALSO
  ib legal types, ib legal show

EXAMPLES
  ib legal active
  ib legal list
  ib legal active --language en
"
`;

