exports[`Help snapshots — contract stability > help for ib vehicle get matches snapshot 1`] = `
"USAGE
  ib vehicle get <vehicleId> [flags]
  (also: ib vehicle show)

DESCRIPTION
  Get a single vehicle by id. --asiakas reads a vehicle owned by ANOTHER company (cross-tenant; developer/admin lever) — without it the lookup is scoped to the active company and a foreign vehicleId returns 404.
  Permissions: requires auth.page.vehicle.read, --asiakas: sysadmin/developer or a vehicle-manage role (admin/owner/vehicleHandler) on the target tenant.

ARGUMENTS
  <vehicleId> NUMBER    vehicleId to fetch (required)

FLAGS
  --asiakas NUMBER    Read a vehicle owned by this company (cross-tenant). Requires sysadmin/developer or a vehicle-manage role on that tenant; default = active company.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { vehicleId, vehicleNo, name, plate, type, typeName, boomLength, capacity, sortNo, firstDate:YYYY-MM-DD|null, lastDate:YYYY-MM-DD|null, memo, billingProductId, asiakasId, ownerAsiakasId, defaultDriverId, showInGrid:boolean, showInReports:boolean, useNoDriverBar:boolean, isRestricted:boolean, hasGpsTracking:boolean }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --asiakas is not an integer >= 1, rejected locally before any request → pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach
  exit 5 (HTTP 404)  Vehicle not found      → verify vehicleId (and --asiakas if it belongs to another company)
  exit 3 (HTTP 403)  No vehicle access on the requested --asiakas company → use a tenant you have a vehicle-manage role on, or a developer token
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.vehicle.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - \`asiakasId\` and \`ownerAsiakasId\` are distinct columns and often equal. \`ownerAsiakasId\` is the tenant this read is scoped to, so it is the SAME on every row of one response (the active company, or \`--asiakas\`); \`asiakasId\` is the assigned company and is what the grid splits own-vs-foreign vehicles on.

EXAMPLES
  ib vehicle get 7
  ib vehicle get 159 --asiakas 1380
"
`;

exports[`Help snapshots — contract stability > help for ib vehicle list matches snapshot 1`] = `
"USAGE
  ib vehicle list [flags]

DESCRIPTION
  List vehicles visible to the active company. ownerAsiakasId derived from JWT. Rows are self-describing (showInGrid/firstDate/lastDate/deletedTime). Default scope = non-deleted with no narrowing, so grid-hidden AND expired vehicles ARE included; only soft-deleted are excluded. Use the flags to narrow or to reveal deleted rows. --asiakas lists ANOTHER company's fleet (cross-tenant; developer/admin lever) instead of the active company.
  Permissions: requires auth.page.vehicle.read, --asiakas: sysadmin/developer or a vehicle-manage role (admin/owner/vehicleHandler) on the target tenant.
  Timezone: dates interpreted in active company timezone (Europe/Helsinki).

FLAGS
  --limit NUMBER    Max rows (capped at 500) (default: 100)
  --deleted    Include soft-deleted vehicles (default: excluded)
  --grid-only    Only vehicles shown in the grid (showInGrid=1)
  --valid-on DATE    Only vehicles whose validity window covers this day (YYYY-MM-DD or today/yesterday/tomorrow)
  --type NUMBER    Only this vehicleTypeId (see \`ib vehicle types\`)
  --asiakas NUMBER    List another company's fleet (cross-tenant). Requires sysadmin/developer or a vehicle-manage role on that tenant; default = active company.
  --cursor STRING    Pagination cursor (from a previous page's nextCursor)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ vehicleId, vehicleNo, plate, name, type, typeName, capacity, sortNo, showInGrid:boolean, firstDate:YYYY-MM-DD|null, lastDate:YYYY-MM-DD|null, deletedTime:ISO|null, asiakasId, ownerAsiakasId, placeholder?:true }> (+truncated:true when the result hit the limit; backend ≥ 2026-06-11)

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --asiakas is not an integer >= 1, rejected locally before any request → pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this command caps at 500 — page past it with \`--cursor\` from the previous response's \`nextCursor\`
  exit 3 (HTTP 403)  No vehicle access on the requested --asiakas company → use a tenant you have a vehicle-manage role on, or a developer token
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.vehicle.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - \`placeholder: true\` marks a legacy sentinel row (e.g. vehicleId 0 'Ei tietoa') that is listed but NOT addressable — \`ib vehicle get 0\` / \`ib vehicle driver assign 0 …\` exit 4. The key is absent on real vehicles. Which tenants carry one varies.
  - Rows come back ordered by \`vehicleNo\` (then vehicleId), NOT by \`sortNo\` — the grid orders on \`sortNo\`, so sort client-side to reproduce its row order.
  - \`asiakasId\` and \`ownerAsiakasId\` are distinct columns and often equal. \`ownerAsiakasId\` is the tenant this read is scoped to, so it is the SAME on every row of one response (the active company, or \`--asiakas\`); \`asiakasId\` is the assigned company and is what the grid splits own-vs-foreign vehicles on.

SEE ALSO
  ib vehicle types

EXAMPLES
  ib vehicle list
  ib vehicle list --pretty
  ib vehicle list --grid-only --valid-on today
  ib vehicle list --deleted
  ib vehicle list --type 1
  ib vehicle list --asiakas 1380
"
`;

exports[`Help snapshots — contract stability > help for ib vehicle locations matches snapshot 1`] = `
"USAGE
  ib vehicle locations [flags]

DESCRIPTION
  Fleet-wide live GPS snapshot for the active company (via Ecofleet, cached 60s). gpsAvailable:false when Ecofleet is not enabled.
  Permissions: requires auth.page.vehicle.read.

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ vehicleId|null, matched, plate, objectName, lat, lng, speed, direction, engineState, address, at, ageMinutes|null, stale }> & { gpsAvailable, staleAfterMinutes }

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.vehicle.read
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Rows are Ecofleet OBJECTS, not vehicles: an object whose plate matches no dbo.vehicle row of the active company (retired truck, subcontractor unit, typo'd reg-no) returns vehicleId:null with matched:false. That is expected data, not an error — filter on \`matched\`, don't treat the null as a failure.
  - \`stale:true\` means the TRACKER stopped reporting (ageMinutes > staleAfterMinutes, default 60), so the coordinates say where the vehicle was, not where it is. A months-old ping still carries its last speed/direction, so without this flag a dead tracker reads as a truck currently driving.
  - \`stale\` is about the tracker, not the truck: a depot-parked vehicle whose tracker pinged 20 minutes ago is fresh (stale:false) with speed 0. Use \`ageMinutes\` to apply your own threshold — \`staleAfterMinutes\` echoes the one behind the boolean.
  - A missing or unparseable ping timestamp yields ageMinutes:null and stale:true — freshness cannot be vouched for, so it is never reported fresh.

EXAMPLES
  ib vehicle locations
  ib vehicle locations --pretty
"
`;

exports[`Help snapshots — contract stability > help for ib vehicle log matches snapshot 1`] = `
"USAGE
  ib vehicle log <vehicleId> [flags]

DESCRIPTION
  Change-tracker audit trail for one vehicle — who changed which field, when, old→new, with --reason. Alias of \`ib log entity vehicle\`. For day-driver history use \`ib vehicle driver history\` (personPvm-based). GET /api/changes/vehicle/:vehicleId/:ownerAsiakasId.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <vehicleId> NUMBER    vehicleId (required)

FLAGS
  --owner NUMBER    ownerAsiakasId (default: active company; a non-integer value exits 4 client-side)
  --limit NUMBER    Max rows (capped at 500) (default: 100)
  --field STRING    Filter by fieldName (e.g. vehicleRegNo)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ changeId, entityType, entityId, field, oldValue, newValue, changeType, personId, personName, at, description, reason, impersonatedByPersonName }> (+truncated:true when the page filled --limit — cursor-less route, so a full page may hide older rows) (+hint when --field filtered a capped page: the filter saw only the newest --limit rows)

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this cursor-less route caps at 500 — raise --limit to reach older rows (\`--field\` only narrows the page you already fetched)
  exit 3 (HTTP 403)  Not a member of that company (and not admin) → ib company switch to that owner, or use an admin token
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib log entity, ib vehicle driver history

EXAMPLES
  ib vehicle log 53
"
`;

