exports[`Help snapshots — contract stability > help for ib log user matches snapshot 1`] = `
"USAGE
  ib log user [<personId>] [flags]

DESCRIPTION
  Changes MADE BY a person. Without personId: your own recent changes (GET /api/changes/user/recent/:owner — any member). With personId: that person's changes (GET /api/changes/user/:personId/:owner — self or admin). Rows carry entityDisplayName (e.g. '12345 - Tilaus') instead of personName (the actor IS the queried person).
  Auth: requires login (any authenticated user).

ARGUMENTS
  <personId> NUMBER    Whose changes (omit = yourself; others need admin) (optional)

FLAGS
  --owner NUMBER    ownerAsiakasId (default: active company; a non-integer value exits 4 client-side)
  --limit NUMBER    Max rows (cap 500) (default: 100)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ changeId, entityType, entityId, field, oldValue, newValue, changeType, at, description, deviceType, entityDisplayName, reason, impersonatedByPersonName }> (+truncated:true when the page filled --limit — cursor-less route, so a full page may hide older rows)

ERRORS (stderr, exit non-zero)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 4 (client-side)  --limit is not an integer >= 1, rejected locally before any request → pass a positive integer; this cursor-less route caps at 500 — raise --limit, or use \`ib log range --person <id> --from\`/\`--to\` for a date-ranged view
  exit 3 (HTTP 403)  Another person's history without an admin role → omit personId, or use an admin token
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib log user
  ib log user 63 --limit 50
"
`;

