exports[`Help snapshots — contract stability > help for ib jerry admin request extend matches snapshot 1`] = `
"USAGE
  ib jerry admin request extend <requestId> [flags]

DESCRIPTION
  Extend a request's validity (POST /api/admin/jerry-requests/:id/extend). Sets expiresAt to now + --days (default 14, i.e. 2 weeks) or an absolute --until date; the new expiry must be in the future. An 'expired' request is reactivated to 'open'; open/no_supply/pending_verification keep their status (a no_supply request stays in Koko markkina, never Päättyneet). draft/cancelled/accepted → 409. System-admin only. Requires --reason.
  Permissions: requires isSystemAdmin.

ARGUMENTS
  <requestId> NUMBER    pumppuRequestId (required)

FLAGS
  --days NUMBER    Valid for N more days from now; mutually exclusive with --until. Omit BOTH for the backend default of 14 days
  --until STRING    Absolute new expiry (ISO date/datetime); mutually exclusive with --days
  --reason STRING    Audit-log reason (X-Action-Reason); REQUIRED

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { success: true, status, expiresAt } or { dryRun: true, wouldUpdate: { pumppuRequestId, expiresAt } }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  --days and --until passed together → pass exactly one, or neither for the default 14 days
  exit 4 (HTTP 400)  Bad date/days          → use a positive --days or a future --until
  exit 3 (HTTP 403)  Not a system admin     → use a system-admin token
  exit 4 (HTTP 409)  Wrong state            → request not in an extendable state (draft/cancelled/accepted)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib jerry admin request extend 32 --days 14 --reason "reactivate"
"
`;

exports[`Help snapshots — contract stability > help for ib jerry admin request get matches snapshot 1`] = `
"USAGE
  ib jerry admin request get <requestId> [flags]
  (also: ib jerry admin request show)

DESCRIPTION
  One request's full detail — date, customer, placing operator, worksite, m³, status, offer count, accepted/best price, plus the send-time recipient list with per-company fanout state (notified/viewed/declined/hasOffer) (GET /api/admin/jerry-requests/:id). Read \`viewSource\`, not \`viewedAt\`, to judge provider engagement: a view recorded through the tokenized preview link has no authenticated person behind it, so \`viewedAt\` alone counts an email-link click as a provider reading the lead (fb#638). For the offers use \`ib jerry admin request offers\`. System-admin only.
  Permissions: requires isSystemAdmin.

ARGUMENTS
  <requestId> NUMBER    pumppuRequestId (required)

FLAGS
  (none)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { pumppuRequestId, status, createdAt, sentAt, expiresAt, totalM3, kayttokohde, customerAsiakasId, customerNimi, operatorName, osoite, offerCount, acceptedPriceCents, bestPriceCents, recipients: [{ asiakasId, asiakasNimi, notifiedAt, viewedAt, viewSource, viewedByPersonId, viewedByName, declinedAt, declineReason, declinedByPersonId, declinedByName, hasOffer }] }. viewSource: null = never opened · "authenticated" = a signed-in person opened it (viewedByPersonId/viewedByName name them) · "link" = opened through the tokenized preview link, nobody authenticated.

ERRORS (stderr, exit non-zero)
  exit 4 (HTTP 400)  Invalid id             → pass a numeric requestId
  exit 3 (HTTP 403)  Not a system admin     → use a system-admin token
  exit 5 (HTTP 404)  Request not found      → verify pumppuRequestId
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib jerry admin request get 41
"
`;

exports[`Help snapshots — contract stability > help for ib jerry admin request list matches snapshot 1`] = `
"USAGE
  ib jerry admin request list [flags]

DESCRIPTION
  System-wide tarjouspyyntö list with offer summary — date, customer, placing operator, worksite, m³, status, offer count, accepted/best price (GET /api/admin/jerry-requests). Filters: --status (CSV), --from/--to (createdAt), --customer, --provider, --limit. --provider does not only filter, it WIDENS every row with that company's own fan-out state — see OUTPUT. System-admin only.
  Permissions: requires isSystemAdmin.

FLAGS
  --status STRING    Status CSV: draft,open,no_supply,pending_verification,accepted,cancelled,expired
  --from STRING    createdAt from (YYYY-MM-DD/today/yesterday)
  --to STRING    createdAt to (inclusive)
  --customer NUMBER    Customer asiakasId
  --provider NUMBER    Provider asiakasId — also WIDENS each row with that provider's own fan-out state (see OUTPUT)
  --limit NUMBER    Max rows (max 300) (default: 300)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  ListEnvelope<{ pumppuRequestId, status, createdAt, sentAt, expiresAt, customerAsiakasId, customerNimi, operatorName, osoite, totalM3, kayttokohde, offerCount, acceptedPriceCents, bestPriceCents, sourceChannel }>. Under --provider each row ALSO carries provider: { notifiedAt, viewedAt, viewSource, viewedByPersonId, declinedAt, declineReason, offerStatus, offerPriceCents } — that one company's own fan-out state. \`viewSource\` is 'authenticated' | 'link' | null and is the field to read, NOT viewedAt: it separates a provider who signed in and opened the lead from somebody who clicked the tokenized link in the notification email, which viewedAt alone conflates (fb#638).

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Unknown status in --status, rejected locally. The ROUTE rejects the same value with 400 since puminet5api@1.29.0 (fb#656) — this saves the round-trip, it is not a divergent contract → use only: draft, open, no_supply, pending_verification, accepted, cancelled, expired
  exit 4 (client-side)  --customer/--provider/--limit is not a positive integer, rejected locally before any request → pass a positive integer; resolve an asiakasId with \`ib company list\`
  exit 4 (HTTP 400)  The route rejected a filter value. --status/--customer/--provider/--limit are all guarded locally, so in practice this is --from/--to: an unparseable date is a 400 since puminet5api@1.29.2 (fb#693, and a 500 before that), and the CLI passes any non-today/yesterday/tomorrow value through unvalidated → pass --from/--to as YYYY-MM-DD (or today/yesterday/tomorrow)
  exit 3 (HTTP 403)  Not a system admin     → use a system-admin token
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib jerry admin request stats

EXAMPLES
  ib jerry admin request list --status open,accepted
  ib jerry admin request list --provider 1402 --from 2026-06-01
"
`;

