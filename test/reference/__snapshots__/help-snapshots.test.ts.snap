exports[`Help snapshots — contract stability > help for ib message support contact matches snapshot 1`] = `
"USAGE
  ib message support contact --body <body> [flags]

DESCRIPTION
  Open (or append to) a support thread escalating a tarjous (pumppuRequest) or keikka to the platform. Any authenticated user. A REAL write — honours the read-only write-lock. --dry-run resolves CLIENT-SIDE (prints the payload, never POSTs). Reply later with \`ib message chat send <threadId> --body ...\`.
  Auth: requires login (any authenticated user).

FLAGS
  --tarjous NUMBER    pumppuRequestId this escalation is about
  --keikka NUMBER    keikkaId this escalation is about
  --body STRING    The message to support (required)
  --dry-run    Print the payload without sending (client-side)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { threadId, message } on success. With --dry-run: { dryRun:true, wouldSend:{ method, path, body } }.

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Validation             → Provide exactly one of --keikka / --tarjous (positive integer) and a non-empty --body
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Exactly one of --keikka / --tarjous selects the context; --keikka wins if both are passed.
  - reply with: ib message chat send <threadId> --body ...

SEE ALSO
  ib message chat send, ib message support inbox

EXAMPLES
  ib message support contact --tarjous 23 --body "Provider not responding — please intervene"
  ib message support contact --keikka 5012 --body "Wrong worksite assigned" --dry-run
"
`;

exports[`Help snapshots — contract stability > help for ib message support inbox matches snapshot 1`] = `
"USAGE
  ib message support inbox [flags]

DESCRIPTION
  Support triage queue: support threads escalated by operators, newest first. Developer-only (isSystemAdmin / isDeveloper). Filter by lifecycle status. Projects GET /api/messages/support/inbox into the list envelope.
  Permissions: requires isSystemAdmin or isDeveloper.

FLAGS
  --status STRING    open | resolved | all (default: open)
  --limit NUMBER    Max rows

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { items: SupportThreadRow[], nextCursor: null, count, truncated }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Validation             → --status must be open|resolved|all
  exit 3 (HTTP 403)  Permission denied      → requires a developer token (isSystemAdmin/isDeveloper)
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Read a thread's messages with \`ib message chat list <threadId>\` and reply with \`ib message chat send <threadId> --body ...\` (a support thread is a normal messageThread admins can read).

SEE ALSO
  ib message chat list, ib message support resolve

EXAMPLES
  ib message support inbox
  ib message support inbox --status all --limit 50
"
`;

exports[`Help snapshots — contract stability > help for ib message support mine matches snapshot 1`] = `
"USAGE
  ib message support mine [flags]

DESCRIPTION
  Your own company's support threads (audience='support', owned by your active company), newest first. The operator-facing companion to the developer-only inbox — any member of the owning company may list them. Filter by lifecycle status. Projects GET /api/messages/support/mine into the list envelope; each row carries a caller-scoped unreadCount.

FLAGS
  --status STRING    open | resolved | all (default: open)
  --limit NUMBER    Max rows

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { items: SupportThreadRow[], nextCursor: null, count, truncated }

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Validation             → --status must be open|resolved|all
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 5 (HTTP 404)  Route not deployed     → the /support/mine backend may not be deployed yet
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Read a thread's messages with \`ib message chat list <threadId>\` and reply with \`ib message chat send <threadId> --body ...\`. Open (or append to) a new escalation with \`ib message support contact\`.

SEE ALSO
  ib message support contact, ib message chat list

EXAMPLES
  ib message support mine
  ib message support mine --status all --limit 50
"
`;

exports[`Help snapshots — contract stability > help for ib message support resolve matches snapshot 1`] = `
"USAGE
  ib message support resolve <threadId> [flags]

DESCRIPTION
  Mark a support thread resolved, or --reopen it back to open. Developer-only (isSystemAdmin / isDeveloper). A REAL write (PATCH) — blocked under --read-only (exit 3). --dry-run previews the body client-side without sending.
  Permissions: requires isSystemAdmin or isDeveloper.

ARGUMENTS
  <threadId> NUMBER    support messageThread id (required)

FLAGS
  --reopen    Set status back to open instead of resolved
  --dry-run    Print the update body without sending (client-side)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { threadId, status } on success. With --dry-run: { dryRun:true, wouldSend:{ method, path, body } }.

ERRORS (stderr, exit non-zero)
  exit 4 (client-side)  Validation             → threadId must be a positive number
  exit 3 (HTTP 403)  Permission denied      → requires a developer token; also refused under --read-only
  exit 5 (HTTP 404)  Not found              → check the threadId via \`ib message support inbox\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

SEE ALSO
  ib message support inbox, ib message chat list

EXAMPLES
  ib message support resolve 42
  ib message support resolve 42 --reopen
"
`;

exports[`Help snapshots — contract stability > help for ib message thread archive matches snapshot 1`] = `
"USAGE
  ib message thread archive [<threadId>] [flags]

DESCRIPTION
  Archive a thread (POST /api/messages/threads/:id/archive). Sets archivedAt — the thread becomes read-only; send/edit/restore then 409. Idempotent (already archived → alreadyArchived:true). Manager-gated: owning-company admin or sysadmin/developer.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <threadId> NUMBER    Thread id (omit when using --tarjous) (optional)

FLAGS
  --tarjous NUMBER    Resolve the thread from this pumppuRequestId

WRITE-SAFETY FLAGS
  --dry-run            CLIENT-side preview: resolves locally, no write reaches the wire (works under --read-only).
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { threadId, archived:true } (+ alreadyArchived:true if already archived)

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  Not a manager of this thread → requires owning-company admin role or sysadmin/developer
  exit 5 (HTTP 404)  Thread not found       → check the threadId via \`ib message chat threads\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Manager-gated (canManageThread): owning-company admin/owner, or isSystemAdmin/isDeveloper.
  - Archived thread is read-only — send/edit/restore return 409 until reopened.
  - Idempotent: archiving an already-archived thread returns alreadyArchived:true (no error).
  - --dry-run resolves CLIENT-SIDE (the messages routes honour no X-Dry-Run): it returns { dryRun:true, wouldArchive:{...} } and never POSTs — works under --read-only.
  - Deploy-gated: the archive route must be deployed to the target backend.

SEE ALSO
  ib message thread reopen, ib message chat send

EXAMPLES
  ib message thread archive 3 --reason "case closed"
  ib message thread archive --tarjous 23
"
`;

exports[`Help snapshots — contract stability > help for ib message thread participant add matches snapshot 1`] = `
"USAGE
  ib message thread participant add [<threadId>] --person <person> [flags]

DESCRIPTION
  Add a colleague to a thread (POST /api/messages/threads/:id/participants; body { personId, role? }). The person must be a member of the thread's owning company (asiakasPerson membership check — the privacy gate; cross-company adds are blocked at 403). Idempotent via MERGE (reactivates a soft-left row). Manager-gated.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <threadId> NUMBER    Thread id (omit when using --tarjous) (optional)

FLAGS
  --tarjous NUMBER    Resolve the thread from this pumppuRequestId
  --person NUMBER    personId to add (required)
  --role STRING    Participant role (customer|pumppu|betoni|lattia|support|provider; default pumppu)

WRITE-SAFETY FLAGS
  --dry-run            CLIENT-side preview: resolves locally, no write reaches the wire (works under --read-only).
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { threadId, personId, role, added:true }

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  Not a manager of this thread → requires owning-company admin role or sysadmin/developer
  exit 3 (HTTP 403)  Person not in owning company → the person must be a member of thread.ownerAsiakasId (asiakasPerson membership — privacy gate; cross-company adds are blocked)
  exit 5 (HTTP 404)  Thread not found       → check the threadId via \`ib message chat threads\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Manager-gated (canManageThread): owning-company admin/owner, or isSystemAdmin/isDeveloper.
  - Privacy gate: the added person must be a member of the thread's owning company (asiakasPerson JOIN). Cross-company adds are blocked at 403.
  - Idempotent: re-adding a participant who left reactivates the row (sets leftAt = NULL) and updates role.
  - --dry-run resolves CLIENT-SIDE (the messages routes honour no X-Dry-Run): it returns { dryRun:true, wouldAdd:{...} } and never POSTs — works under --read-only.
  - Deploy-gated: the participants route must be deployed to the target backend.

SEE ALSO
  ib message thread participant remove, ib message chat thread

EXAMPLES
  ib message thread participant add 3 --person 42
  ib message thread participant add 3 --person 42 --role pumppu --reason "added to cover"
  ib message thread participant add --tarjous 23 --person 42
"
`;

exports[`Help snapshots — contract stability > help for ib message thread participant remove matches snapshot 1`] = `
"USAGE
  ib message thread participant remove [<threadId>] --person <person> [flags]

DESCRIPTION
  Soft-remove a participant from a thread (DELETE /api/messages/threads/:id/participants/:personId; sets leftAt = now). Manager-gated: owning-company admin or sysadmin/developer.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <threadId> NUMBER    Thread id (omit when using --tarjous) (optional)

FLAGS
  --tarjous NUMBER    Resolve the thread from this pumppuRequestId
  --person NUMBER    personId to remove (required)

WRITE-SAFETY FLAGS
  --dry-run            CLIENT-side preview: resolves locally, no write reaches the wire (works under --read-only).
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { threadId, personId, removed:true|false } (removed:false when the participant was already gone)

ERRORS (stderr, exit non-zero)
  exit 3 (HTTP 403)  Not a manager of this thread → requires owning-company admin role or sysadmin/developer
  exit 5 (HTTP 404)  Thread not found       → check the threadId via \`ib message chat threads\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Manager-gated (canManageThread): owning-company admin/owner, or isSystemAdmin/isDeveloper.
  - Soft-remove: sets leftAt = now (the row is kept for audit). removed:false when the participant had already left.
  - --dry-run resolves CLIENT-SIDE (the messages routes honour no X-Dry-Run): it returns { dryRun:true, wouldRemove:{...} } and never DELETEs — works under --read-only.
  - Deploy-gated: the participants route must be deployed to the target backend.

SEE ALSO
  ib message thread participant add, ib message chat thread

EXAMPLES
  ib message thread participant remove 3 --person 42 --reason "left project"
  ib message thread participant remove --tarjous 23 --person 42
"
`;

exports[`Help snapshots — contract stability > help for ib message thread rename matches snapshot 1`] = `
"USAGE
  ib message thread rename [<threadId>] --title <title> [flags]

DESCRIPTION
  Set or clear the thread title (PATCH /api/messages/threads/:id; body { title }). Title max 200 chars; empty string clears it (sets to NULL). Manager-gated: owning-company admin or sysadmin/developer. Requires the messageThread.title migration to have run on the DB before the rename route is deployed.
  Auth: requires login (any authenticated user).

ARGUMENTS
  <threadId> NUMBER    Thread id (omit when using --tarjous) (optional)

FLAGS
  --tarjous NUMBER    Resolve the thread from this pumppuRequestId
  --title STRING    New thread title (max 200 chars; "" clears) (required)

WRITE-SAFETY FLAGS
  --dry-run            CLIENT-side preview: resolves locally, no write reaches the wire (works under --read-only).
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification. Stored in audit log.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { threadId, title } (title is null when cleared)

ERRORS (stderr, exit non-zero)
  exit 4 (HTTP 400)  Title too long         → max 200 characters
  exit 3 (HTTP 403)  Not a manager of this thread → requires owning-company admin role or sysadmin/developer
  exit 5 (HTTP 404)  Thread not found       → check the threadId via \`ib message chat threads\`
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - Manager-gated (canManageThread): owning-company admin/owner, or isSystemAdmin/isDeveloper.
  - Pass --title "" to clear the title (sets messageThread.title = NULL). On Windows PowerShell a bare "" is DROPPED and the NEXT flag silently becomes the value — use the equals form \`--title=\` there, which means the same thing in bash (\`ib help shell-quoting\`).
  - --dry-run resolves CLIENT-SIDE (the messages routes honour no X-Dry-Run): it returns { dryRun:true, wouldRename:{...} } and never PATCHes — works under --read-only.
  - Deploy-gated: requires the messageThread.title migration (2026-06-21-messageThread-title.sql) to run on the DB BEFORE the rename route deploys — otherwise the backend 500s on missing column.

SEE ALSO
  ib message chat thread, ib message thread archive

EXAMPLES
  ib message thread rename 3 --title "Betonijerry #42 — toimitus valmis"
  ib message thread rename --tarjous 23 --title ""
"
`;

