exports[`Help snapshots — contract stability > help for ib person delete matches snapshot 1`] = `
"USAGE
  ib person delete <personId> [flags]

DESCRIPTION
  Delete a person. Requires --reason.
  Permissions: requires auth.page.person.edit.

ARGUMENTS
  <personId> NUMBER    personId to delete (required)

FLAGS
  --reason STRING    Audit-log reason (X-Action-Reason); REQUIRED

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { deleted: number } or { dryRun: true, wouldDelete: { personId } }

ERRORS (stderr, exit non-zero)
  exit 5 (HTTP 404)  Person not found IN SCOPE → the id may be fine and the SCOPE wrong — these commands read the ACTIVE company only. Either the personId does not exist, or it belongs to another tenant: retry with \`--asiakas <id>\` (on \`person get\`), find them with \`ib customer person list --asiakas <id>\` or \`ib person search --my-companies\`, or switch lens with \`ib company switch <id>\`. Do NOT conclude the person does not exist and create a new one — that mints a duplicate.
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.person.edit
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib person delete 5351 --reason "departed"
"
`;

exports[`Help snapshots — contract stability > help for ib person duplicates matches snapshot 1`] = `
"USAGE
  ib person duplicates [flags]

DESCRIPTION
  List likely-duplicate person pairs for one tenant: same normalized phone (high), same email (high), or same first+last name (medium). Both rows must be older than 1 month. Read-only; admin gated server-side. Owner defaults to your active company; --owner scans another tenant. Feeds \`ib person merge\`.
  Permissions: requires company admin on the tenant (system admin for another owner).

FLAGS
  --owner NUMBER    ownerAsiakasId to scan (default: active company; a non-integer value exits 4 client-side)
  --unowned    Scan the UNOWNED class instead — persons whose ownerAsiakasId is 0 or NULL (self-registrations, imports, pre-ownership rows). System admin only; mutually exclusive with --owner (fb#849)

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { items: [{ id1, name1, id2, name2, matchCode: 'phone'|'email'|'full_name', matchValue, confidence: 'high'|'medium' }], count, truncated? } — truncated=true when capped at 100 pairs

ERRORS (stderr, exit non-zero)
  exit 4 (HTTP 400)  ownerAsiakasId missing/invalid → pass --owner <id>, or set an active company
  exit 3 (HTTP 403)  Not permitted on this tenant → ib company switch to that owner, or use an admin token
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

NOTES
  - full_name is a medium-confidence heuristic (identical first+last name) — a human confirms before merging.
  - Each pair is returned once (id1 < id2), top 100 by confidence.

SEE ALSO
  ib person merge, ib person get

EXAMPLES
  ib person duplicates
  ib person duplicates --owner 1349
  ib person duplicates --unowned
"
`;

exports[`Help snapshots — contract stability > help for ib person email add matches snapshot 1`] = `
"USAGE
  ib person email add <person> <email> [flags]

DESCRIPTION
  Add an ALTERNATIVE email to a person (the personEmails one-to-many; the primary is managed via \`ib person update\`). Tenant-scoped: self, a person owned by your active company, or any person for developers/sysadmins; global persons only by self/developer. Emails are globally unique. Requires --reason.
  Permissions: requires auth.page.person.edit.

ARGUMENTS
  <person> STRING    personId or a name resolved within your active company (required)
  <email> STRING    alternative email to add (<=250 chars) (required)

FLAGS
  --reason STRING    Audit-log reason (X-Action-Reason); REQUIRED

WRITE-SAFETY FLAGS
  --dry-run            Validate without persisting (server-side X-Dry-Run). Returns the would-be response.
                       If the backend does NOT honour it, the CLI exits 6 rather than reporting a write as a preview.
  --idempotency-key K  Replay protection. Cached for 24h.
  --reason TEXT        Free-text justification, stored in audit log. REQUIRED.

GLOBAL FLAGS
  --endpoint URL  --request-id ID  --quiet  --verbose  --pretty  --json  --read-only  --company ID  --stats  --columns CSV  --print-payload
  --company runs ONE command as another company (ephemeral, not persisted) · ib help multi-tenancy

OUTPUT (JSON, stdout)
  { personId, personEmail, added: boolean } · dry-run: { dryRun:true, wouldAdd:{ personId, personEmail } }

ERRORS (stderr, exit non-zero)
  exit 4 (HTTP 400)  Equals the primary email, or invalid/too-long email → manage the primary via \`ib person update\`; check the address
  exit 5 (HTTP 404)  Person not found / out of your tenant → verify the person is in your active company (or switch company)
  exit 4 (HTTP 409)  Email already belongs to another person (globally unique) → use a different address
  exit 2 (HTTP 401)  Token expired          → ib auth refresh
  exit 3 (HTTP 403)  Permission denied      → check auth.page.person.edit
  exit 6 (HTTP 500)  Backend error          → retry with --verbose

EXAMPLES
  ib person email add 5351 matti.alt@example.com --reason 'secondary contact'
  ib person email add 5351 matti.alt@example.com --reason preview --dry-run
"
`;

