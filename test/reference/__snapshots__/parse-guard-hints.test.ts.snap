  > pass a positive integer; max is 1000, and the 200 default returns a PARTIAL catalogue (dbo holds ~240 tables) — pass \`--limit 1000\` whenever you intend to enumerate

ib schema triggers --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; max is 1000, and the 200 default returns a PARTIAL catalogue — pass \`--limit 1000\` whenever you intend to enumerate

ib schema views --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; max is 1000, and the 200 default returns a PARTIAL catalogue — pass \`--limit 1000\` whenever you intend to enumerate

ib sijainti closest --asiakas <id>
  ! --asiakas must be an integer >= 1
  > name the worksite once (--worksite OR --tyomaa) and pass integer ids

ib sijainti closest --tyomaa <id>
  ! --tyomaa must be an integer >= 1
  > name the worksite once (--worksite OR --tyomaa) and pass integer ids

ib sijainti closest --type <id>
  ! --type must be an integer >= 1
  > name the worksite once (--worksite OR --tyomaa) and pass integer ids

ib sijainti closest --worksite <id>
  ! --worksite must be an integer >= 1
  > name the worksite once (--worksite OR --tyomaa) and pass integer ids

ib sijainti create --asiakas <id>
  ! --asiakas must be an integer >= 1
  > pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach

ib sijainti list --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; this command caps at 500, so narrow by type rather than raising the cap

ib sijainti plants --limit <n>
  ! --limit must be an integer >= 1
  > pass a numeric asiakasId (see ownerAsiakasId in the output, or resolve the company via \`ib search <name>\`)

ib task add --asiakas <id>
  ! --asiakas must be an integer >= 1
  > --title, --executor (human|ai) and one of --cadence (<count>/<unit>) or --once are required (from flags or --from-json); --agent must be claude|hermes; unit must be day|week|month, count 1-120; --assignee/--asiakas/--feedback must be integers

ib task add --assignee <personId>
  ! --assignee must be an integer >= 1
  > --title, --executor (human|ai) and one of --cadence (<count>/<unit>) or --once are required (from flags or --from-json); --agent must be claude|hermes; unit must be day|week|month, count 1-120; --assignee/--asiakas/--feedback must be integers

ib task add --feedback <id>
  ! --feedback must be an integer >= 1
  > --title, --executor (human|ai) and one of --cadence (<count>/<unit>) or --once are required (from flags or --from-json); --agent must be claude|hermes; unit must be day|week|month, count 1-120; --assignee/--asiakas/--feedback must be integers

ib task list --asiakas <id>
  ! --asiakas must be an integer >= 1
  > --executor must be human|ai; --agent must be claude|hermes; --assignee/--asiakas/--limit/--offset must be integers

ib task list --assignee <personId>
  ! --assignee must be an integer >= 1
  > --executor must be human|ai; --agent must be claude|hermes; --assignee/--asiakas/--limit/--offset must be integers

ib task list --limit <n>
  ! --limit must be an integer >= 1
  > --executor must be human|ai; --agent must be claude|hermes; --assignee/--asiakas/--limit/--offset must be integers

ib task list --offset <n>
  ! --offset must be an integer >= 0
  > --executor must be human|ai; --agent must be claude|hermes; --assignee/--asiakas/--limit/--offset must be integers

ib task log --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; this command caps at 200, so narrow by task rather than raising the cap

ib task set --asiakas <id>
  ! --asiakas must be an integer >= 1
  > provide at least one field; --activate/--deactivate and enum values as documented; --assignee/--asiakas must be integers

ib task set --assignee <personId>
  ! --assignee must be an integer >= 1
  > provide at least one field; --activate/--deactivate and enum values as documented; --assignee/--asiakas must be integers

ib validate --keikka <id>
  ! --keikka must be an integer >= 1
  > pass a keikkaId

ib vehicle create --asiakas <id>
  ! --asiakas must be an integer >= 1
  > pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach

ib vehicle create --capacity <m3>
  ! --capacity must be a number
  > pass the capacity in m3 as a number (e.g. 7.5)

ib vehicle create --default-driver <pid>
  ! --default-driver must be an integer >= 1
  > pass a personId — \`ib person search\` finds them

ib vehicle create --no <n>
  ! --no must be an integer >= 0
  > pass the fleet number as an integer

ib vehicle create --puomi <m>
  ! --puomi must be a number
  > pass the boom length in metres as a number

ib vehicle create --type <n>
  ! --type must be an integer >= 1
  > pass a vehicleTypeId — \`ib vehicle types\` lists them

ib vehicle dates expiring --days <n>
  ! --days must be an integer >= 1
  > pass a positive number of days (default 30)

ib vehicle get --asiakas <id>
  ! --asiakas must be an integer >= 1
  > pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach

ib vehicle list --asiakas <id>
  ! --asiakas must be an integer >= 1
  > pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach

ib vehicle list --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; this command caps at 500 — page past it with \`--cursor\` from the previous response's \`nextCursor\`

ib vehicle list --type <id>
  ! --type must be an integer >= 1
  > pass a vehicleTypeId — \`ib vehicle types\` lists them

ib vehicle log --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; this cursor-less route caps at 500 — raise --limit to reach older rows (\`--field\` only narrows the page you already fetched)

ib vehicle log --owner <id>
  ! --owner must be an integer >= 1
  > --owner takes an ownerAsiakasId (an integer) — omit it entirely to read the active company, or resolve one with \`ib company list\`

ib vehicle search --asiakas <id>
  ! --asiakas must be an integer >= 1
  > pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach

ib vehicle search --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; this command caps at 500, so narrow the search term rather than raising the cap

ib vehicle types --asiakas <id>
  ! --asiakas must be an integer >= 1
  > pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach

ib vehicle update --asiakas <id>
  ! --asiakas must be an integer >= 1
  > pass a positive asiakasId (a company id) — \`ib company list\` shows the ones you can reach

ib vehicle update --capacity <m3>
  ! --capacity must be a number
  > pass the capacity in m3 as a number (e.g. 7.5)

ib vehicle update --no <n>
  ! --no must be an integer >= 0
  > pass the fleet number as an integer

ib vehicle update --puomi <m>
  ! --puomi must be a number
  > pass the boom length in metres as a number

ib vehicle update --type <n>
  ! --type must be an integer >= 1
  > pass a vehicleTypeId — \`ib vehicle types\` lists them

ib vehicle visits --days <n>
  ! --days must be an integer >= 1
  > pass a positive number of days (omit for all-time)

ib weather day --lat <n>
  ! --lat must be a number
  > pass decimal degrees, e.g. --lat 60.17 --lng 24.94

ib weather day --lng <n>
  ! --lng must be a number
  > pass decimal degrees, e.g. --lat 60.17 --lng 24.94

ib weather forecast --lat <n>
  ! --lat must be a number
  > pass decimal degrees, e.g. --lat 60.1699 --lng 24.9384

ib weather forecast --lng <n>
  ! --lng must be a number
  > pass decimal degrees, e.g. --lat 60.1699 --lng 24.9384

ib weather pumping --duration <min>
  ! --duration must be an integer >= 1
  > pass decimal degrees and whole minutes, e.g. --lat 60.17 --lng 24.94 --duration 120

ib weather pumping --keikka <id>
  ! --keikka must be an integer >= 1
  > pass decimal degrees and whole minutes, e.g. --lat 60.17 --lng 24.94 --duration 120

ib weather pumping --lat <n>
  ! --lat must be a number
  > pass decimal degrees and whole minutes, e.g. --lat 60.17 --lng 24.94 --duration 120

ib weather pumping --lng <n>
  ! --lng must be a number
  > pass decimal degrees and whole minutes, e.g. --lat 60.17 --lng 24.94 --duration 120

