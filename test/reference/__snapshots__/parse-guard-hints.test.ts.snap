  > --owner takes an ownerAsiakasId (an integer) — omit it entirely to read the active company, or resolve one with \`ib company list\`

ib worksite list --customer <n>
  ! --customer must be an integer >= 1
  > pass a positive asiakasId

ib worksite list --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; this command caps at 500 — page past it with \`--cursor\` from the previous response's \`nextCursor\`

ib worksite log --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; this cursor-less route caps at 500 — raise --limit to reach older rows (\`--field\` only narrows the page you already fetched)

ib worksite log --owner <id>
  ! --owner must be an integer >= 1
  > --owner takes an ownerAsiakasId (an integer) — omit it entirely to read the active company, or resolve one with \`ib company list\`

ib worksite merge --owner <id>
  ! --owner must be an integer >= 1
  > --owner takes an ownerAsiakasId (an integer) — omit it entirely to read the active company, or resolve one with \`ib company list\`

ib worksite person add --contact-type <id>
  ! --contact-type must be an integer >= 1
  > pass a valid contactPersonTypeId (1, 2, 3, or 5)

ib worksite person add --person <id>
  ! --person must be an integer >= 1
  > pass a positive personId

ib worksite person add --worksite <id>
  ! --worksite must be an integer >= 1
  > pass a positive tyomaaId

ib worksite person remove --contact-type <id>
  ! --contact-type must be an integer >= 1
  > pass a valid contactPersonTypeId (1, 2, 3, or 5)

ib worksite person remove --person <id>
  ! --person must be an integer >= 1
  > pass a positive personId

ib worksite person remove --worksite <id>
  ! --worksite must be an integer >= 1
  > pass a positive tyomaaId

ib worksite search --limit <n>
  ! --limit must be an integer >= 1
  > pass a positive integer; the backend caps at 100, so narrow the search term rather than raising the cap

ib worksite update --contact-person <id>
  ! --contact-person must be an integer >= 0
  > pass a positive personId, or 0 to clear the contact"
`;
